---
export const prerender=true;
---
<!doctype html><html lang="pl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="referrer" content="no-referrer"><title>Połączenie z Google — Przydaś</title><style>body{font:16px/1.6 system-ui,sans-serif;margin:0;background:#f5f9f7;color:#172b3a;display:grid;place-items:center;min-height:100vh}main{max-width:460px;margin:20px;padding:28px;background:white;border:1px solid #d8e3df;border-radius:18px}h1{font-size:25px;line-height:1.3}a{color:#087a42}button{font:inherit;background:#108d45;color:white;padding:10px 18px;border:0;border-radius:9px;cursor:pointer}@media(prefers-color-scheme:dark){body{background:#101a23;color:#eef3f7}main{background:#17212b;border-color:#3a4a56}a{color:#7ee1ac}}</style></head><body><main><h1 id="title">Połączenie z Kalendarzem Google</h1><p id="message">Wróć do ustawień Przydasia i sprawdź status integracji.</p><button id="close" type="button">Zamknij okno</button><p><a href="https://app.xn--przyda-8ib.pl/ustawienia/">Wróć do Przydasia</a></p></main><script>const status=new URLSearchParams(location.search).get('status');const texts={connected:['Kalendarz połączony','Możesz zamknąć to okno. Przydaś będzie automatycznie kopiować i aktualizować Twoje rezerwacje w Google.'],cancelled:['Połączenie anulowane','Nie włączono nowego połączenia. Możesz wrócić do ustawień i spróbować ponownie.'],error:['Nie udało się połączyć','Wróć do ustawień Przydasia i spróbuj ponownie. Upewnij się, że zatwierdzasz dostęp do kalendarza.']};const text=texts[status as keyof typeof texts];if(text){document.getElementById('title')!.textContent=text[0];document.getElementById('message')!.textContent=text[1];}document.getElementById('close')!.addEventListener('click',()=>window.close());history.replaceState(null,'',location.pathname);</script></body></html>
