---
const problems = [
  {
    no: '01',
    title: 'Gdzie jest ta rezerwacja?',
    text: 'Kalendarz, notatki, wiadomości i szczegóły wydarzenia w kilku różnych miejscach.',
  },
  {
    no: '02',
    title: 'Kto może pracować?',
    text: 'Dziesiątki wiadomości do zespołu, żeby zebrać dyspozycyjność na konkretny termin.',
  },
  {
    no: '03',
    title: 'Kto potwierdził?',
    text: 'Ręczne pilnowanie, kto przyjął event, kto odpisał i komu trzeba się jeszcze przypomnieć.',
  },
  {
    no: '04',
    title: 'Czy o czymś zapomnieliśmy?',
    text: 'Brakujące dane, materiały, rozliczenia i rzeczy do zrobienia wychodzą często dopiero przed wydarzeniem.',
  },
];

const capabilities = [
  ['Rezerwacje i kalendarz', 'Wszystkie wydarzenia, szczegóły i terminy w jednym miejscu.'],
  ['Zespół i dyspozycyjność', 'Wiesz, kto może pracować, kto został przypisany i za co odpowiada.'],
  ['Powiadomienia i braki', 'Przydaś przypomina o rzeczach, których nie warto pilnować ręcznie.'],
  ['Rozliczenia i statystyki', 'Po evencie dane zostają w systemie i pomagają rozliczać oraz rozwijać firmę.'],
];

const beforeEvent = [
  {
    no: '01',
    title: 'Przyjmujesz rezerwację',
    text: 'Termin, klient, kategoria wydarzenia, szczegóły, atrakcje, materiały i najważniejsze ustalenia trafiają do jednego miejsca.',
  },
  {
    no: '02',
    title: 'Zbierasz dyspozycyjność',
    text: 'Zbierasz dostępność zespołu, przygotowujesz zadania, przypinasz checklisty i od razu widzisz, czego jeszcze brakuje.',
  },
  {
    no: '03',
    title: 'Kompletujesz zespół',
    text: 'Wybierasz animatorów, przypisujesz role i zadania, wskazujesz osobę odpowiedzialną i kontrolujesz gotowość zespołu.',
  },
];

const afterEvent = [
  {
    no: '04',
    title: 'Ankieta po zleceniu',
    text: 'Zespół zostawia feedback po realizacji, zgłasza braki lub uszkodzenia i przekazuje informacje o przebiegu oraz jakości zlecenia.',
  },
  {
    no: '05',
    title: 'Rozliczasz zlecenie',
    text: 'Kontrolujesz rozliczenie pracowników i wydarzenia, płatności oraz informacje potrzebne do zamknięcia zlecenia i wystawienia faktury.',
  },
  {
    no: '06',
    title: 'Budujesz statystyki',
    text: 'Zakończone zlecenie trafia do zestawień i analiz, dzięki którym widzisz wyniki, rentowność i dane potrzebne do kolejnych decyzji.',
  },
];

const audiences = [
  {
    plan: 'START',
    eyebrow: 'Mała firma / początek porządkowania',
    title: 'Działasz sam lub z małym zespołem',
    text: 'Masz coraz więcej rezerwacji i chcesz wreszcie trzymać kalendarz, szczegóły wydarzeń i podstawową organizację w jednym miejscu.',
    bullets: ['Rezerwacje i kalendarz', 'Dyspozycyjność i przypisania', 'Podstawowe powiadomienia i braki'],
  },
  {
    plan: 'ZESPÓŁ',
    eyebrow: 'Firma rośnie',
    title: 'Zarządzasz zespołem animatorów',
    text: 'Firma rośnie i potrzebujesz więcej kontroli nad przygotowaniem realizacji, zadaniami, odpowiedzialnością i pracą całego zespołu.',
    bullets: ['Dni kluczowe i osoba odpowiedzialna', 'Zadania i rozliczenia pracowników', 'Ankiety, checklisty i pełne powiadomienia'],
  },
  {
    plan: 'BIZNES',
    eyebrow: 'Pełna kontrola firmy',
    title: 'Prowadzisz firmę, nie tylko eventy',
    text: 'Chcesz widzieć nie tylko co dzieje się jutro, ale też jak firma działa po realizacji: rozliczenia, feedback, wyniki i dane do decyzji.',
    bullets: ['Materiały, zakupy i magazyn', 'Integracje, faktury i eksport danych', 'Zaawansowane statystyki i kontrola firmy'],
  },
];
import PackagesSection from '../components/PackagesSection.astro';
import FinalSections from '../components/FinalSections.astro';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Przydaś porządkuje rezerwacje, kalendarz, zespół, dyspozycyjność, rozliczenia i statystyki firm z branży animacyjnej."
    />
    <meta name="theme-color" content="#13ad6f" />
    <title>Przydaś — system dla firm animacyjnych</title>
    <link rel="canonical" href="https://xn--przyda-8ib.pl/" />
    <link rel="icon" href="/przydas-mark.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content="Przydaś — ogarnij eventy, zespół i firmę" />
    <meta property="og:description" content="Rezerwacje, kalendarz, zespół, dyspozycyjność, braki, rozliczenia i statystyki w jednym systemie dla branży animacyjnej." />
    <meta property="og:url" content="https://xn--przyda-8ib.pl/" />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Przydaś",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "description": "System do zarządzania rezerwacjami, kalendarzem, zespołem, dyspozycyjnością, rozliczeniami i statystykami firm z branży animacyjnej.",
        "offers": {
          "@type": "AggregateOffer",
          "priceCurrency": "PLN",
          "lowPrice": "59",
          "highPrice": "199",
          "offerCount": "3"
        }
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav-wrap">
        <a href="#top" class="brand" aria-label="Przydaś - strona główna">
          <span class="brand-mark" aria-hidden="true"><img src="/przydas-mark.svg" alt="" /></span>
          <span>Przydaś</span>
        </a>

        <nav class="nav-links" aria-label="Nawigacja główna">
          <a href="#funkcje">Funkcje</a>
          <a href="#dla-kogo">Dla kogo</a>
          <a href="#cennik">Cennik</a>
          <a href="#faq">FAQ</a>
        </nav>

        <div class="nav-actions">
          <a class="login-link" href="https://app.xn--przyda-8ib.pl/">Zaloguj się</a>
          <a class="button button-primary button-small" href="#cennik">Zobacz pakiety <span>→</span></a>
        </div>
      </div>
    </header>

    <main id="top">
      <section class="hero shell">
        <div class="hero-copy">
          <div class="eyebrow-pill">
            <span>✣</span>
            System stworzony dla branży animacyjnej
          </div>
          <h1>Ogarnij eventy.<br />Zespół. Firmę.</h1>
          <p class="hero-lead">
            Przydaś zbiera rezerwacje, kalendarz, zespół, dyspozycyjność i codzienną organizację w jednym miejscu.
            Mniej wiadomości, mniej chaosu, więcej czasu na rozwój firmy.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#cennik">Zobacz pakiety <span>→</span></a>
            <a class="button button-secondary" href="#jak-dziala">Zobacz, jak działa <span>→</span></a>
          </div>
          <div class="micro-proof">
            <span class="proof-dot"></span>
            Kalendarz, zespół, dyspozycyjność, braki, rozliczenia i statystyki — w jednym miejscu.
          </div>
        </div>

        <div class="hero-visual" aria-label="Podgląd aplikacji Przydaś">
          <div class="app-window hero-app">
            <div class="app-topbar">
              <div class="app-topbar-title"><span class="status-dot"></span> Panel firmy</div>
              <div class="avatar-icon">P</div>
            </div>
            <div class="app-body">
              <aside class="app-sidebar">
                <strong>Przegląd</strong>
                <span>Eventy</span>
                <span>Zespół</span>
                <span>Kalendarz</span>
                <span>Rozliczenia</span>
              </aside>
              <div class="dashboard">
                <div class="dashboard-head">
                  <div>
                    <span class="muted-label">Dzisiaj</span>
                    <h3>Twój dzisiejszy plan</h3>
                  </div>
                  <span class="today-chip">22 sierpnia</span>
                </div>
                <div class="event-card">
                  <div>
                    <strong>Warsztaty rodzinne</strong>
                    <span>10:00-12:00 · Centrum Kultury</span>
                  </div>
                  <span class="ready-chip">Zespół gotowy</span>
                </div>
                <div class="event-card">
                  <div>
                    <strong>Piknik firmowy</strong>
                    <span>15:30-18:00 · Park Miejski</span>
                  </div>
                  <span class="check">✓</span>
                </div>
                <div class="dashboard-stats">
                  <div><b>3</b><span>eventy</span></div>
                  <div><b>8</b><span>osób w zespole</span></div>
                  <div><b>0</b><span>pilnych braków</span></div>
                </div>
              </div>
            </div>
          </div>
          <div class="visual-glow"></div>
        </div>
      </section>

      <section class="problem-section" id="problem">
        <div class="shell">
          <div class="section-head problem-head">
            <span class="eyebrow-text">Brzmi znajomo?</span>
            <h2>Firma rośnie. Chaos razem z nią.</h2>
            <p>
              Rezerwacje w kalendarzu. Dyspozycyjność na Messengerze. Lista animatorów w Excelu. Potwierdzenia w wiadomościach.
              A przed eventem i tak trzeba sprawdzić wszystko jeszcze raz.
            </p>
          </div>

          <div class="problem-grid">
            {problems.map((problem) => (
              <article class="problem-card">
                <span class="problem-number">{problem.no}</span>
                <h3>{problem.title}</h3>
                <p>{problem.text}</p>
              </article>
            ))}
          </div>

          <div class="section-transition">
            <strong>Przydaś zbiera to w jednym miejscu.</strong>
            <span class="transition-line"></span>
            <a href="#funkcje" aria-label="Przejdź do funkcji">→</a>
          </div>
        </div>
      </section>

      <section class="solution-section" id="funkcje">
        <div class="shell">
          <div class="section-head section-head-narrow">
            <span class="eyebrow-text">Jedno miejsce zamiast dziesięciu</span>
            <h2>Przydaś ogarnia codzienność Twojej firmy.</h2>
            <p>
              Od pierwszej rezerwacji, przez przygotowanie i realizację wydarzenia, aż po rozliczenie i analizę wyników.
              Najważniejsze informacje o firmie masz zawsze pod ręką.
            </p>
          </div>

          <div class="solution-grid">
            <div class="product-preview">
              <div class="preview-head">
                <div><span class="status-dot"></span> Przydaś · dzisiaj</div>
                <span class="ready-chip">✓ 3 wydarzenia</span>
              </div>
              <div class="preview-content">
                <div class="preview-events">
                  <div class="preview-label">Plan wydarzeń <span>22 sierpnia</span></div>
                  <div class="mini-event active"><strong>Animacje w ogrodzie</strong><span>11:00 · 4 animatorów</span></div>
                  <div class="mini-event"><strong>Urodziny Mai</strong><span>15:30 · komplet danych</span></div>
                  <div class="mini-event"><strong>Warsztaty</strong><span>18:00 · gotowe</span></div>
                </div>
                <div class="preview-team">
                  <div class="preview-label">Zespół</div>
                  <div class="team-row"><span class="team-dot pale"></span> Ola · dostępna</div>
                  <div class="team-row"><span class="team-dot strong"></span> Kuba · w drodze</div>
                  <div class="team-row"><span class="team-dot"></span> Marta · potwierdzone</div>
                </div>
              </div>
            </div>

            <div class="capabilities">
              {capabilities.map(([title, text]) => (
                <article class="capability">
                  <span class="capability-icon">✓</span>
                  <div>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </div>
                </article>
              ))}
              <a class="button button-secondary capability-cta" href="#jak-dziala">Zobacz, jak działa <span>→</span></a>
            </div>
          </div>
        </div>
      </section>

      <section class="lifecycle-section" id="jak-dziala">
        <div class="shell">
          <div class="section-head lifecycle-head">
            <span class="eyebrow-text">Cały proces w jednym systemie</span>
            <h2>Od rezerwacji do danych.<br />Cały cykl wydarzenia w jednym miejscu.</h2>
            <p>
              Przydaś pomaga przygotować wydarzenie i zespół, a po realizacji zbiera informacje potrzebne do podsumowania,
              rozliczenia i dalszego rozwoju firmy.
            </p>
          </div>

          <div class="phase-block before-phase">
            <div class="phase-header">
              <div>
                <span class="phase-kicker">PRZED WYDARZENIEM</span>
                <h3>Przygotuj realizację bez biegania po wiadomościach i arkuszach.</h3>
              </div>
            </div>
            <div class="phase-grid">
              {beforeEvent.map((step) => (
                <article class="lifecycle-card">
                  <span class="step-number">{step.no}</span>
                  <h4>{step.title}</h4>
                  <p>{step.text}</p>
                </article>
              ))}
            </div>
          </div>

          <div class="phase-bridge" aria-hidden="true">
            <span>EVENT</span>
            <i></i>
          </div>

          <div class="phase-block after-phase">
            <div class="phase-header">
              <div>
                <span class="phase-kicker">PO WYDARZENIU · BIZNES</span>
                <h3>Event się kończy. Przydaś pracuje dalej.</h3>
              </div>
            </div>
            <div class="phase-grid">
              {afterEvent.map((step) => (
                <article class="lifecycle-card post-event">
                  <span class="step-number">{step.no}</span>
                  <h4>{step.title}</h4>
                  <p>{step.text}</p>
                </article>
              ))}
            </div>
          </div>

          <div class="business-value">
            <div class="business-value-copy">
              <span class="eyebrow-text">Dane zamiast domysłów</span>
              <h3>Każde wydarzenie buduje wiedzę o Twojej firmie.</h3>
              <p>
                Zakończone zlecenia nie znikają w archiwum. Zebrane dane wspierają rozliczenia, pokazują wyniki i z czasem
                tworzą statystyki potrzebne do podejmowania lepszych decyzji biznesowych.
              </p>
            </div>
            <div class="stats-demo" aria-label="Przykładowe statystyki firmy">
              <div class="stat-box"><span>Przychód</span><strong>48 600 zł</strong><em>+18% vs poprzedni okres</em></div>
              <div class="stat-box"><span>Rentowność eventów</span><strong>31%</strong><em>najlepszy miesiąc w sezonie</em></div>
              <div class="stat-box wide"><span>Najczęstsze źródło zleceń</span><strong>Polecenia klientów</strong><em>37% wszystkich rezerwacji</em></div>
            </div>
          </div>
        </div>
      </section>

      <section class="audience-section" id="dla-kogo">
        <div class="shell">
          <div class="section-head audience-head">
            <span class="eyebrow-text">Dla kogo jest Przydaś?</span>
            <h2>Rośnie razem z Twoją firmą.</h2>
            <p>
              Nie każda firma potrzebuje od razu wszystkiego. Przydaś możesz zacząć od prostego porządku w rezerwacjach,
              a wraz z rozwojem zespołu przejść do pełnej kontroli operacyjnej i biznesowej.
            </p>
          </div>

          <div class="audience-grid">
            {audiences.map((audience, index) => (
              <article class:list={['audience-card', index === 1 && 'audience-card-featured', index === 2 && 'audience-card-business']}>
                <div class="audience-top">
                  <span class="audience-plan">{audience.plan}</span>
                  <span class="audience-eyebrow">{audience.eyebrow}</span>
                </div>
                <h3>{audience.title}</h3>
                <p>{audience.text}</p>
                <ul>
                  {audience.bullets.map((bullet) => (
                    <li><span>✓</span>{bullet}</li>
                  ))}
                </ul>
              </article>
            ))}
          </div>

          <div class="audience-cta">
            <div>
              <strong>Nie musisz wybierać systemu na wyrost.</strong>
              <span>Zaczynasz od tego, czego potrzebujesz dziś. Reszta czeka, kiedy firma urośnie.</span>
            </div>
            <a class="button button-primary" href="#cennik">Zobacz pakiety <span>→</span></a>
          </div>
        </div>
      </section>

      <PackagesSection />

      <FinalSections />

    </main>
  </body>
</html>

<style is:global>
  :root {
    --green: #12ad70;
    --green-dark: #078a59;
    --green-soft: #eaf8f2;
    --green-softer: #f5fbf8;
    --ink: #13201a;
    --muted: #6f7a74;
    --line: #dfe7e2;
    --surface: #ffffff;
    --soft: #f6f9f7;
    --radius: 24px;
    --shadow: 0 22px 55px rgba(20, 72, 48, 0.09);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    color: var(--ink);
    background: #fff;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, h4, p { margin-top: 0; }
  .shell { width: min(1120px, calc(100% - 48px)); margin-inline: auto; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255,255,255,.88);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(223,231,226,.65);
  }
  .nav-wrap { min-height: 84px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-size: 22px; font-weight: 800; width: fit-content; letter-spacing: -.02em; }
  .brand-mark { width: 32px; height: 32px; border-radius: 10px; overflow: hidden; background: transparent; display: grid; place-items: center; box-shadow: 0 8px 18px rgba(20,72,48,.08); }
  .brand-mark img { display: block; width: 32px; height: 32px; }
  .nav-links { display: flex; align-items: center; gap: 34px; font-size: 15px; font-weight: 600; }
  .nav-links a, .login-link { transition: color .2s ease; }
  .nav-links a:hover, .login-link:hover { color: var(--green-dark); }
  .nav-actions { justify-self: end; display: flex; gap: 22px; align-items: center; font-size: 15px; font-weight: 600; }

  .button { min-height: 50px; padding: 0 20px; border-radius: 13px; display: inline-flex; align-items: center; justify-content: center; gap: 14px; font-weight: 750; font-size: 15px; transition: transform .2s ease, box-shadow .2s ease, background .2s ease; }
  .button:hover { transform: translateY(-2px); }
  .button-primary { color: #fff; background: var(--green); box-shadow: 0 12px 26px rgba(18,173,112,.2); }
  .button-primary:hover { background: var(--green-dark); box-shadow: 0 14px 30px rgba(18,173,112,.24); }
  .button-secondary { background: #fff; border: 1px solid var(--line); }
  .button-small { min-height: 44px; padding-inline: 18px; }

  .hero { min-height: 680px; display: grid; grid-template-columns: .95fr 1.05fr; gap: 72px; align-items: center; padding-block: 72px 82px; }
  .eyebrow-pill { display: inline-flex; align-items: center; gap: 8px; padding: 9px 13px; border-radius: 999px; background: var(--green-soft); color: var(--green-dark); font-size: 13px; font-weight: 750; }
  .hero h1 { margin: 30px 0 24px; font-size: clamp(54px, 5.2vw, 76px); line-height: .98; letter-spacing: -.055em; font-weight: 820; }
  .hero-lead { max-width: 580px; color: var(--muted); font-size: 19px; line-height: 1.55; letter-spacing: -.015em; }
  .hero-actions { display: flex; gap: 12px; margin-top: 30px; flex-wrap: wrap; }
  .micro-proof { margin-top: 22px; display: flex; align-items: center; gap: 10px; color: #718078; font-size: 13px; }
  .proof-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 5px var(--green-soft); }

  .hero-visual { position: relative; }
  .visual-glow { position: absolute; z-index: -1; inset: 12% -6% -7% 10%; background: radial-gradient(circle at center, rgba(18,173,112,.17), rgba(18,173,112,0) 65%); filter: blur(10px); }
  .app-window { overflow: hidden; border: 1px solid #d9e8df; border-radius: 25px; background: #fff; box-shadow: var(--shadow); }
  .hero-app { transform: perspective(1200px) rotateY(-1.2deg) rotateX(.4deg); }
  .app-topbar { height: 72px; display: flex; align-items: center; justify-content: space-between; padding: 0 22px; border-bottom: 1px solid var(--line); }
  .app-topbar-title { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 750; }
  .status-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--green); display: inline-block; }
  .avatar-icon { width: 34px; height: 34px; border-radius: 11px; background: var(--green-soft); color: var(--green-dark); display: grid; place-items: center; font-size: 13px; font-weight: 800; }
  .app-body { min-height: 394px; display: grid; grid-template-columns: 118px 1fr; }
  .app-sidebar { padding: 24px 16px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 16px; font-size: 12px; color: #758078; }
  .app-sidebar strong { color: var(--green-dark); }
  .dashboard { padding: 26px 24px; }
  .dashboard-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
