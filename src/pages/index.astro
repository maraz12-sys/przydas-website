---
import LandingTop from '../components/LandingTop.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import PackagesSection from '../components/PackagesSection.astro';
import FinalSections from '../components/FinalSections.astro';
import LegalFooter from '../components/LegalFooter.astro';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Przydaś porządkuje rezerwacje i zespół, pilnuje braków, pomaga zbierać dane od klientów i automatyzuje rozliczenia pracowników w firmach animacyjnych."
    />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#087f53" />
    <meta name="color-scheme" content="light" />

    <title>Przydaś — system dla firm animacyjnych | mniej chaosu, więcej czasu</title>
    <link rel="canonical" href="https://xn--przyda-8ib.pl/" />
    <link rel="icon" href="/przydas-mark.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Przydaś" />
    <meta property="og:title" content="Przydaś — mniej pilnowania, więcej czasu na firmę" />
    <meta
      property="og:description"
      content="Rezerwacje, formularze dla klientów, zespół, braki, rozliczenia pracowników, statystyki i historia klientów w jednym systemie dla branży animacyjnej."
    />
    <meta property="og:url" content="https://xn--przyda-8ib.pl/" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Przydaś — system dla firm animacyjnych" />
    <meta
      name="twitter:description"
      content="Mniej ręcznego pilnowania eventów i zespołu. Więcej czasu, kontroli i danych do prowadzenia firmy."
    />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Przydaś",
        "url": "https://xn--przyda-8ib.pl/",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "inLanguage": "pl-PL",
        "description": "System dla firm animacyjnych do zarządzania rezerwacjami, formularzami dla klientów, zespołem, dyspozycyjnością, brakami, rozliczeniami pracowników, statystykami i historią klientów.",
        "offers": {
          "@type": "AggregateOffer",
          "priceCurrency": "PLN",
          "lowPrice": "59",
          "highPrice": "249",
          "offerCount": "3"
        },
        "featureList": [
          "Rezerwacje i kalendarz",
          "Zespół i dyspozycyjność",
          "Powiadomienia i braki",
          "Formularze rezerwacyjne dla klientów",
          "Rozliczenia pracowników i wypłaty",
          "Statystyki",
          "Historia klientów"
        ]
      }
    </script>
  </head>
  <body>
    <main>
      <LandingTop />
      <ProductShowcase />
      <PackagesSection />
      <FinalSections />
      <LegalFooter />
    </main>
  </body>
</html>

<style is:global>
  /* FinalSections has the original lightweight footer. The complete legal/contact
     footer below replaces it without touching the stable sales component. */
  .site-footer { display: none !important; }

  @media (max-width: 640px) {
    body { padding-bottom: 0 !important; }

    .comparison-mobile-hint { display: none !important; }
    .comparison-table-wrap {
      height: auto !important;
      max-height: none !important;
      overflow: visible !important;
      border: 0 !important;
      border-radius: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
    }
    .comparison-table {
      width: 100% !important;
      min-width: 0 !important;
      display: block !important;
      border-collapse: separate !important;
      font-size: 11px !important;
    }
    .comparison-table thead { display: none !important; }
    .comparison-table tbody { display: grid !important; gap: 7px !important; }
    .comparison-table tbody tr:not(.comparison-category) {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) repeat(3, 64px) !important;
      overflow: hidden;
      border: 1px solid #dfe8e3;
      border-radius: 12px;
      background: #fff;
    }
    .comparison-table th,
    .comparison-table td {
      min-width: 0 !important;
      padding: 10px 7px !important;
      border: 0 !important;
      text-align: center !important;
      background: transparent !important;
    }
    .comparison-table tbody th[scope='row'] {
      width: auto !important;
      padding-left: 11px !important;
      text-align: left !important;
      font-size: 10px !important;
      line-height: 1.3 !important;
      display: flex !important;
      align-items: center !important;
    }
    .comparison-table td {
      border-left: 1px solid #edf2ef !important;
      display: grid !important;
      place-items: center !important;
      align-content: center !important;
      gap: 2px !important;
      font-size: 10px !important;
      font-weight: 850 !important;
      line-height: 1.15 !important;
    }
    .comparison-table td::before {
      color: #728078;
      font-size: 7px;
      font-weight: 900;
      letter-spacing: .04em;
    }
    .comparison-table td:nth-child(2)::before { content: 'START'; }
    .comparison-table td:nth-child(3)::before { content: 'ZESPÓŁ'; }
    .comparison-table td:nth-child(4)::before { content: 'BIZNES'; }
    .comparison-table td:nth-child(3) { background: #f4faf7 !important; }
    .comparison-table td:nth-child(4) { background: #e9f8f0 !important; }
    .comparison-table .comparison-category {
      display: block !important;
      margin-top: 9px;
      border: 0 !important;
      background: transparent !important;
    }
    .comparison-table .comparison-category th {
      width: 100% !important;
      padding: 13px 3px 4px !important;
      display: block !important;
      color: #087f53 !important;
      text-align: left !important;
      font-size: 10px !important;
      font-weight: 900 !important;
      line-height: 1.2 !important;
      letter-spacing: .06em !important;
    }
  }
</style>
