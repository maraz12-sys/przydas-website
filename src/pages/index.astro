---
import LandingTop from '../components/LandingTop.astro';
import PackagesSection from '../components/PackagesSection.astro';
import FinalSections from '../components/FinalSections.astro';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Przydaś pomaga firmom animacyjnym oszczędzać czas, porządkować rezerwacje i zespół, ograniczać braki, rozliczać eventy i wracać do klientów."
    />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#087f53" />
    <meta name="color-scheme" content="light" />

    <title>Przydaś — system dla firm animacyjnych | mniej chaosu, więcej czasu</title>
    <link rel="canonical" href="https://xn--przyda-8ib.pl/" />
    <link rel="icon" href="/przydas-mark.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Przydaś" />
    <meta property="og:title" content="Przydaś — mniej pilnowania, więcej czasu na firmę" />
    <meta
      property="og:description"
      content="Rezerwacje, zespół, braki, rozliczenia, statystyki i historia klientów w jednym systemie stworzonym dla branży animacyjnej."
    />
    <meta property="og:url" content="https://xn--przyda-8ib.pl/" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Przydaś — system dla firm animacyjnych" />
    <meta
      name="twitter:description"
      content="Mniej ręcznego pilnowania eventów i zespołu. Więcej czasu, kontroli i danych do prowadzenia firmy."
    />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Przydaś",
        "url": "https://xn--przyda-8ib.pl/",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "inLanguage": "pl-PL",
        "description": "System dla firm animacyjnych do zarządzania rezerwacjami, kalendarzem, zespołem, dyspozycyjnością, brakami, rozliczeniami, statystykami i historią klientów.",
        "offers": {
          "@type": "AggregateOffer",
          "priceCurrency": "PLN",
          "lowPrice": "59",
          "highPrice": "199",
          "offerCount": "3"
        },
        "featureList": [
          "Rezerwacje i kalendarz",
          "Zespół i dyspozycyjność",
          "Powiadomienia i braki",
          "Rozliczenia",
          "Statystyki",
          "Historia klientów"
        ]
      }
    </script>
  </head>
  <body>
    <main>
      <LandingTop />
      <PackagesSection />
      <FinalSections />
    </main>
  </body>
</html>

<style is:global>
  @media (max-width: 640px) {
    body { padding-bottom: 0 !important; }

    .comparison-mobile-hint { display: none !important; }
    .comparison-table-wrap {
      overflow: visible !important;
      border-radius: 14px !important;
    }
    .comparison-table {
      width: 100% !important;
      min-width: 0 !important;
      table-layout: fixed !important;
      font-size: 9px !important;
    }
    .comparison-table thead th {
      position: static !important;
      top: auto !important;
      padding: 10px 3px !important;
      font-size: 9px !important;
      line-height: 1.2 !important;
    }
    .comparison-table thead th:first-child,
    .comparison-table tbody th[scope='row'] {
      width: 55% !important;
      text-align: left !important;
    }
    .comparison-table thead th:not(:first-child) { width: 15% !important; }
    .comparison-table th,
    .comparison-table td {
      min-width: 0 !important;
      padding: 9px 4px !important;
      overflow-wrap: anywhere;
    }
    .comparison-table tbody th[scope='row'] {
      padding-left: 9px !important;
      font-size: 9px !important;
      line-height: 1.28 !important;
    }
    .comparison-table td {
      font-size: 9px !important;
      font-weight: 800 !important;
    }
    .comparison-table .comparison-category th {
      padding: 14px 9px 7px !important;
      font-size: 9px !important;
      line-height: 1.2 !important;
    }
    .comparison-table thead th span {
      display: none !important;
    }
  }
</style>
