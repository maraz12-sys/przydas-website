---
import LandingTop from '../components/LandingTop.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import PackagesSection from '../components/PackagesSection.astro';
import FinalSections from '../components/FinalSections.astro';
import LegalFooter from '../components/LegalFooter.astro';
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Przydaś porządkuje rezerwacje i zespół, pilnuje braków, pomaga zbierać dane od klientów i automatyzuje rozliczenia pracowników w firmach animacyjnych."
    />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#087f53" />
    <meta name="color-scheme" content="light" />

    <title>Przydaś. — system dla firm animacyjnych | rezerwacje, zespół i rozliczenia</title>
    <link rel="canonical" href="https://xn--przyda-8ib.pl/" />
    <link rel="icon" href="/przydas-mark.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Przydaś." />
    <meta property="og:title" content="Przydaś. — mniej pilnowania, więcej czasu na firmę" />
    <meta
      property="og:description"
      content="Rezerwacje, formularze dla klientów, zespół, braki, rozliczenia pracowników, statystyki i historia klientów w jednym systemie dla branży animacyjnej."
    />
    <meta property="og:url" content="https://xn--przyda-8ib.pl/" />

    <meta property="og:image" content="https://xn--przyda-8ib.pl/przydas-share.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Przydaś — rezerwacje, zespół i rozliczenia w jednym miejscu" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://xn--przyda-8ib.pl/przydas-share.png" />
    <meta name="twitter:title" content="Przydaś. — system dla firm animacyjnych" />
    <meta
      name="twitter:description"
      content="Mniej ręcznego pilnowania wydarzeń i zespołu. Więcej czasu, kontroli i danych do prowadzenia firmy."
    />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "Przydaś.",
        "alternateName": "Przydaś dla firm animacyjnych",
        "url": "https://xn--przyda-8ib.pl/",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "inLanguage": "pl-PL",
        "description": "System dla firm animacyjnych do zarządzania rezerwacjami, formularzami dla klientów, zespołem, dyspozycyjnością, brakami, rozliczeniami pracowników, statystykami i historią klientów.",
        "provider": {
          "@type": "Organization",
          "name": "Ewelina Nalewalska ANIMILANDIA",
          "legalName": "Ewelina Nalewalska ANIMILANDIA",
          "taxID": "5621808600",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Boczna 23",
            "postalCode": "86-031",
            "addressLocality": "Osielsko",
            "addressCountry": "PL"
          }
        },
        "offers": {
          "@type": "AggregateOffer",
          "priceCurrency": "PLN",
          "lowPrice": "59",
          "highPrice": "249",
          "offerCount": "3"
        },
        "featureList": [
          "Rezerwacje i kalendarz",
          "Zespół i dyspozycyjność",
          "Powiadomienia i braki",
          "Formularze rezerwacyjne dla klientów",
          "Rozliczenia pracowników i wypłaty",
          "Statystyki",
          "Historia klientów"
        ]
      }
    </script>
  </head>
  <body>
    <main>
      <LandingTop />
      <ProductShowcase />
      <PackagesSection />
      <FinalSections />
      <LegalFooter />
    </main>
  </body>
</html>

<style is:global>
  .problem-section,.showcase-section,.packages-section,.comparison-section,.faq-section{padding-top:64px!important;padding-bottom:64px!important}

  @media (max-width: 640px) {
    body { padding-bottom: 0 !important; }
    .comparison-mobile-hint { display: block !important; font-size: 13px; }
    .comparison-table-wrap { overflow-x: auto !important; max-width: 100%; }
    .comparison-table { min-width: 640px !important; font-size: 13px !important; }
    .comparison-table th, .comparison-table td { font-size: 13px !important; padding: 12px !important; }
    .comparison-table small { font-size: 12px !important; }
  }
</style>
