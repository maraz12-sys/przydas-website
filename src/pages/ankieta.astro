<!doctype html>
<html lang="pl">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="robots" content="noindex,nofollow,noarchive" /><meta name="referrer" content="no-referrer" /><title>Ankieta po wydarzeniu | Przydaś</title><link rel="icon" href="/przydas-mark.svg" type="image/svg+xml" /></head>
<body><main><header class="survey-topbar"><a id="platform-brand" class="brand" href="/" aria-label="Przydaś"><img src="/przydas-mark.svg" alt="" width="36" height="36" />Przydaś<span>.</span></a><div id="organization-brand" class="organization-brand" hidden><img id="organization-logo" alt="Logo organizacji" referrerpolicy="no-referrer" /></div></header><div id="survey-host"><p role="status">Wczytywanie ankiety…</p></div><a id="platform-footer" class="platform-footer" href="/" hidden><img src="/przydas-mark.svg" alt="" width="18" height="18" />Obsługiwane przez Przydaś</a><noscript>Włącz JavaScript, aby wypełnić ankietę.</noscript></main>
<script>
import {mountSurvey,surveyCopy} from '../lib/customer-surveys/renderer.mjs';
import '../lib/customer-surveys/survey.css';
// Both public forms use the same branding module and the same organization setting.
const brandingReady=import(/* @vite-ignore */ '/form-logo.mjs').catch(()=>null);
const host=document.getElementById('survey-host')!;
const token=location.hash.slice(1);
// Fragment tokens are not sent to hosting logs or referrers. Clear the address after reading.
history.replaceState(null,'',location.pathname);
const api='https://jyzajgbgkqlczjpoxxzt.supabase.co/functions/v1/ankieta-klienta-publiczna';
async function call(action:string,answers?:Record<string,unknown>){const res=await fetch(api,{method:'POST',credentials:'omit',cache:'no-store',headers:{'Content-Type':'application/json'},body:JSON.stringify({action,token,...(answers?{answers}:{})}),signal:AbortSignal.timeout(20000)});const d=await res.json();if(!res.ok||!d.ok)throw new Error(d.message||'Nie udało się otworzyć ankiety. Spróbuj ponownie.');return d;}
function note(text:string){const p=document.createElement('p');p.className='status-note';p.setAttribute('role','status');p.textContent=text;host.replaceChildren(p);}
if(!/^[0-9a-f-]{36}\.[A-Za-z0-9_-]{43}$/.test(token))note('Otwórz ponownie link do ankiety z wiadomości e-mail.');
else call('get').then(data=>{void brandingReady.then(branding=>branding?.applyFormBranding({...data,organization_name:data.organization_logo?.organizationName||''},document));if(data.submitted){host.replaceChildren(surveyCopy(document,data.thanks||'Dziękujemy. Odpowiedź została już zapisana.','cs-copy status-note'));return}mountSurvey(host,{schema:data.definition,eventLabel:data.eventLabel,privacy:data.privacy,onSubmit:async answers=>{await call('submit',answers)}})}).catch(e=>note(e.message||'Nie udało się wczytać ankiety. Otwórz ponownie link z wiadomości.'));
</script>
<style is:global>html{font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:#f3f8f5;color:#17251f}body{margin:0}main{max-width:860px;margin:30px auto;padding:0 16px 50px}.survey-topbar{max-width:820px;margin:0 auto 24px}.brand{display:flex;align-items:center;gap:8px;text-decoration:none;color:inherit;font-size:22px;font-weight:750}.brand span{color:#087f53;margin-left:-8px}.brand img{object-fit:contain}.organization-brand img{display:block;max-width:min(240px,60vw);max-height:72px;object-fit:contain}.platform-footer{display:flex;align-items:center;justify-content:center;gap:6px;margin:14px auto 0;color:#68776f;font-size:10px;text-decoration:none}.platform-footer img{width:18px;height:18px}.brand[hidden],.organization-brand[hidden],.platform-footer[hidden]{display:none}.status-note{padding:24px;border:1px solid #d8e5df;border-radius:14px;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere}.status-note a{color:#087f53;text-decoration:underline;text-underline-offset:3px}.status-note a:focus-visible{outline:3px solid #087f53;outline-offset:3px}@media(prefers-color-scheme:dark){html{background:#0d1419;color:#edf3f7}.status-note{border-color:#354952}.status-note a{color:#73deb0}.platform-footer{color:#adbdc6}}</style>
</body></html>
