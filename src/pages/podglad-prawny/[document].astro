---
import Dpa from '../../legal-drafts/umowa-powierzenia.astro';
import Privacy from '../../legal-drafts/polityka-prywatnosci.astro';
import Providers from '../../legal-drafts/podprocesorzy.astro';
import Payments from '../../legal-drafts/platnosci.astro';
import Overview from '../../legal-drafts/przeglad.astro';
export function getStaticPaths(){
  return process.env.LEGAL_PREVIEW==='1'?['przeglad','umowa-powierzenia','polityka-prywatnosci','podprocesorzy','platnosci'].map(document=>({params:{document}})):[];
}
const docs={'przeglad':Overview,'umowa-powierzenia':Dpa,'polityka-prywatnosci':Privacy,'podprocesorzy':Providers,'platnosci':Payments};
const Document=docs[Astro.params.document];
---
<Document />
