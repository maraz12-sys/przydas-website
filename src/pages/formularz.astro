---
const apiUrl = "https://jyzajgbgkqlczjpoxxzt.supabase.co/functions/v1/formularz-rezerwacyjny-publiczny";
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <title>Formularz wydarzenia | Przydaś</title>
    <style>
      :root{font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#263444;background:#f5f8f6;--g:#159447;--gd:#0f7a39;--soft:#edf8f1;--border:#dce6e0;--muted:#718096;--navy:#172033}
      *{box-sizing:border-box}body{margin:0;min-height:100vh;background:linear-gradient(180deg,#f8fbf9 0,#f3f7f5 100%)}
      .shell{width:min(760px,calc(100% - 28px));margin:0 auto;padding:36px 0 56px}.brand{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}.brand strong{color:var(--gd);font-size:20px}.brand span{font-size:11px;color:#98a2b3}
      .card{border:1px solid var(--border);border-radius:18px;background:#fff;box-shadow:0 14px 42px rgba(19,54,38,.07);overflow:hidden}.head{padding:26px 28px 22px;border-bottom:1px solid #edf2ef}.eyebrow{display:inline-flex;padding:5px 8px;border-radius:999px;background:var(--soft);color:var(--gd);font-size:9px;font-weight:850;letter-spacing:.06em;text-transform:uppercase}.head h1{margin:10px 0 6px;color:var(--navy);font-size:clamp(24px,5vw,34px);line-height:1.12}.head p{margin:0;color:var(--muted);font-size:13px;line-height:1.6}.meta{margin-top:13px;display:flex;gap:7px;flex-wrap:wrap}.meta span{padding:5px 8px;border:1px solid #e4ebe7;border-radius:999px;color:#758194;font-size:9px;background:#fbfcfb}
      .body{padding:25px 28px 28px}.state{min-height:240px;display:grid;place-items:center;text-align:center;padding:28px}.state div{max-width:460px}.state h2{margin:0 0 8px;color:var(--navy);font-size:20px}.state p{margin:0;color:var(--muted);font-size:12px;line-height:1.65}.spinner{width:32px;height:32px;margin:0 auto 14px;border:3px solid #e2eee7;border-top-color:var(--g);border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
      form{display:grid;gap:15px}.field{display:grid;gap:6px}.field>span{font-size:11px;font-weight:780;color:#465467}.field em{font-style:normal;color:#b42318}.field input,.field textarea,.field select{width:100%;border:1px solid #d5dfd9;border-radius:10px;background:#fff;color:#263444;outline:none;font:inherit;font-size:13px;transition:.16s}.field input,.field select{height:46px;padding:0 12px}.field textarea{min-height:108px;padding:11px 12px;resize:vertical}.field input:focus,.field textarea:focus,.field select:focus{border-color:#6db88b;box-shadow:0 0 0 3px rgba(21,148,71,.10)}.check{min-height:48px;padding:11px 12px;display:flex!important;grid-template-columns:none!important;align-items:center;gap:10px;border:1px solid #e0e8e3;border-radius:10px;background:#fbfcfb}.check input{width:20px!important;height:20px!important;accent-color:var(--g);flex:0 0 auto}.check span{font-size:12px!important}.actions{padding-top:4px;display:flex;justify-content:flex-end}.submit{min-height:46px;padding:0 19px;border:0;border-radius:10px;background:var(--g);color:#fff;font-weight:800;cursor:pointer}.submit:hover{background:var(--gd)}.submit:disabled{opacity:.55;cursor:default}.error{padding:10px 12px;border:1px solid #f1c5bf;border-radius:9px;background:#fff4f2;color:#b42318;font-size:11px;line-height:1.5}.privacy{margin:13px auto 0;max-width:620px;text-align:center;color:#8995a5;font-size:9px;line-height:1.55}.privacy a{color:#657385}.success-icon{width:52px;height:52px;margin:0 auto 14px;display:grid;place-items:center;border-radius:50%;background:var(--soft);color:var(--gd);font-size:25px;font-weight:900}
      @media(max-width:600px){.shell{padding:18px 0 35px}.brand{padding:0 4px}.card{border-radius:14px}.head,.body{padding-left:18px;padding-right:18px}.head{padding-top:21px}.actions .submit{width:100%}}
    </style>
  </head>
  <body>
    <main class="shell">
      <div class="brand"><strong>Przydaś</strong><span>Bezpieczny formularz wydarzenia</span></div>
      <section class="card" id="card">
        <div class="state" id="loading"><div><div class="spinner"></div><h2>Ładujemy formularz</h2><p>Sprawdzamy link i przygotowujemy dane.</p></div></div>
      </section>
      <p class="privacy">Dane z formularza są przekazywane organizatorowi wydarzenia za pośrednictwem Przydasia. <a href="/polityka-prywatnosci/" target="_blank" rel="noopener">Polityka prywatności</a>.</p>
    </main>
    <script define:vars={{ apiUrl }}>
      const card = document.getElementById('card');
      const token = new URLSearchParams(window.location.search).get('t') || '';
      let formData = null;

      const esc = (value='') => String(value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char]));
      const fmtDate = value => { if(!value) return ''; const d=new Date(value); return Number.isNaN(d.getTime())?'':new Intl.DateTimeFormat('pl-PL',{day:'2-digit',month:'2-digit',year:'numeric'}).format(d); };
      const callApi = async payload => {
        const response = await fetch(apiUrl,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload),credentials:'omit',cache:'no-store'});
        const data = await response.json().catch(()=>({ok:false,message:'Nieprawidłowa odpowiedź serwera.'}));
        if(!response.ok || data.ok===false) throw new Error(data.message || 'Nie udało się obsłużyć formularza.');
        return data;
      };
      const showState = (title,text,success=false) => {
        card.innerHTML=`<div class="state"><div>${success?'<div class="success-icon">✓</div>':''}<h2>${esc(title)}</h2><p>${esc(text)}</p></div></div>`;
      };
      const renderField = field => {
        const key=esc(field.key),label=esc(field.label||field.key),required=field.required===true?' required':'',mark=field.required===true?' <em>*</em>':'';
        if(field.type==='checkbox') return `<label class="field check"><input type="checkbox" name="${key}"><span>${label}${mark}</span></label>`;
        if(field.type==='textarea') return `<label class="field"><span>${label}${mark}</span><textarea name="${key}"${required}></textarea></label>`;
        const allowed=['date','time','email','tel','number','text']; const type=allowed.includes(field.type)?field.type:'text';
        return `<label class="field"><span>${label}${mark}</span><input type="${type}" name="${key}"${required}${type==='email'?' autocomplete="email"':''}${type==='tel'?' autocomplete="tel"':''}></label>`;
      };
      const renderForm = data => {
        formData=data;
        if(data.completed){showState('Formularz został już przekazany',data.message||'Nie musisz nic więcej robić.',true);return;}
        const fields=Array.isArray(data.fields)?data.fields:[];
        card.innerHTML=`<header class="head"><span class="eyebrow">${esc(data.organization_name||'Organizator')}</span><h1>${esc(data.template_name||'Uzupełnij informacje')}</h1><p>${esc(data.description||'Uzupełnij poniższe informacje dotyczące wydarzenia. Po wysłaniu organizator zweryfikuje dane.')}</p><div class="meta">${data.expires_at?`<span>Link ważny do ${esc(fmtDate(data.expires_at))}</span>`:''}<span>Dane trafiają bezpośrednio do organizatora</span></div></header><div class="body"><form id="reservation-form">${fields.map(renderField).join('')}<div id="form-error"></div><div class="actions"><button class="submit" type="submit">Wyślij formularz</button></div></form></div>`;
        document.getElementById('reservation-form').addEventListener('submit',submitForm);
      };
      const submitForm = async event => {
        event.preventDefault();
        const form=event.currentTarget,button=form.querySelector('.submit'),errorBox=document.getElementById('form-error');
        if(!form.reportValidity()) return;
        const answers={};
        for(const field of (formData?.fields||[])){
          const input=form.elements.namedItem(field.key); if(!input)continue;
          answers[field.key]=field.type==='checkbox'?Boolean(input.checked):String(input.value||'').trim();
        }
        button.disabled=true;button.textContent='Wysyłanie…';errorBox.innerHTML='';
        try{const data=await callApi({action:'submit',token,answers});showState('Dziękujemy',data.message||'Formularz został przekazany organizatorowi do weryfikacji.',true);}
        catch(error){errorBox.innerHTML=`<div class="error">${esc(error.message||'Nie udało się wysłać formularza.')}</div>`;button.disabled=false;button.textContent='Wyślij formularz';}
      };
      (async()=>{
        if(token.length<30){showState('Nieprawidłowy link','Poproś organizatora o ponowne przesłanie formularza.');return;}
        try{renderForm(await callApi({action:'get',token}));}catch(error){showState('Formularz jest niedostępny',error.message||'Link wygasł lub został unieważniony.');}
      })();
    </script>
  </body>
</html>
