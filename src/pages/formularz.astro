---
const apiUrl = "https://jyzajgbgkqlczjpoxxzt.supabase.co/functions/v1/formularz-rezerwacyjny-publiczny";
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#087f53" />
    <title>Formularz wydarzenia | Przydaś</title>
    <link rel="icon" href="/przydas-mark.svg" type="image/svg+xml" />
    <style is:global>
      :root{
        font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
        color:#17251f;
        background:#f3f8f5;
        --green:#087f53;
        --green-2:#10a66b;
        --green-dark:#056941;
        --green-soft:#eaf7f0;
        --ink:#17251f;
        --muted:#68776f;
        --line:#dce8e1;
        --line-strong:#cbdad1;
        --danger:#b42318;
        --danger-soft:#fff3f1;
        --white:#fff;
      }
      *{box-sizing:border-box}
      html{min-height:100%;background:#f3f8f5}
      body{
        margin:0;
        min-height:100vh;
        color:var(--ink);
        background:
          radial-gradient(circle at 8% 4%,rgba(8,127,83,.09),transparent 29rem),
          radial-gradient(circle at 92% 15%,rgba(16,166,107,.07),transparent 26rem),
          linear-gradient(180deg,#f8fbf9 0%,#f1f7f3 100%);
      }
      body.modal-open{overflow:hidden}
      button,input,textarea,select{font:inherit}
      button,a,input,textarea,select{transition:border-color .18s ease,box-shadow .18s ease,background .18s ease,transform .18s ease}
      .page-shell{width:min(980px,calc(100% - 32px));margin:0 auto;padding:30px 0 54px}
      .topbar{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:20px;padding:0 2px}
      .brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink)}
      .brand img{width:38px;height:38px;display:block}
      .brand strong{font-size:20px;letter-spacing:-.025em}
      .secure-label{display:inline-flex;align-items:center;gap:8px;color:#607168;font-size:12px;font-weight:700}
      .secure-label::before{content:"✓";display:grid;place-items:center;width:22px;height:22px;border-radius:999px;background:var(--green-soft);color:var(--green);font-size:12px;font-weight:900}
      .form-card{overflow:hidden;border:1px solid rgba(201,219,208,.9);border-radius:24px;background:rgba(255,255,255,.96);box-shadow:0 28px 80px rgba(24,67,46,.10),0 3px 12px rgba(24,67,46,.04)}
      .head{position:relative;padding:34px 38px 30px;border-bottom:1px solid #e8f0eb;background:linear-gradient(135deg,#ffffff 0%,#fbfdfc 68%,#eff9f4 100%)}
      .head::after{content:"";position:absolute;right:-45px;top:-70px;width:190px;height:190px;border-radius:50%;background:rgba(8,127,83,.055);pointer-events:none}
      .organization{position:relative;z-index:1;display:inline-flex;align-items:center;gap:8px;margin-bottom:15px;padding:7px 10px;border:1px solid #d8e9df;border-radius:999px;background:#f4fbf7;color:var(--green-dark);font-size:11px;font-weight:850;letter-spacing:.02em}
      .organization::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--green-2);box-shadow:0 0 0 4px rgba(16,166,107,.10)}
      .head h1{position:relative;z-index:1;margin:0;color:#15231d;font-size:clamp(30px,4.8vw,46px);line-height:1.06;letter-spacing:-.045em}
      .head p{position:relative;z-index:1;max-width:700px;margin:13px 0 0;color:var(--muted);font-size:14px;line-height:1.65}
      .meta{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
      .meta span{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border:1px solid #e0eae4;border-radius:10px;background:rgba(255,255,255,.82);color:#6d7b74;font-size:11px;font-weight:700}
      .meta span::before{content:"✓";color:var(--green);font-weight:900}
      .form-body{padding:32px 38px 36px}
      .process-note{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;margin:0 0 24px;padding:14px 16px;border:1px solid #d8e9df;border-radius:14px;background:#f7fcf9;color:#52655b}
      .process-note::before{content:"i";grid-row:1/4;display:grid;place-items:center;width:25px;height:25px;margin-top:1px;border-radius:999px;background:#e6f6ed;color:var(--green);font-size:12px;font-weight:900}
      .process-note strong{color:#2c4035;font-size:12px}
      .process-note span{font-size:11px;line-height:1.55}
      .process-note small{color:#75847c;font-size:10px;font-weight:700;line-height:1.45}
      .form-intro{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:22px}
      .form-intro strong{display:block;font-size:15px;letter-spacing:-.01em}
      .form-intro span{display:block;margin-top:4px;color:#7a8981;font-size:11px}
      .required-note{flex:0 0 auto;padding:6px 9px;border-radius:9px;background:#f7faf8;color:#718078;font-size:10px!important;font-weight:700}
      form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px 16px}
      .field{display:grid;align-content:start;gap:7px;min-width:0}
      .field.field-wide{grid-column:1/-1}
      .field[hidden]{display:none!important}
      .field>span{display:flex;align-items:center;gap:5px;color:#34453c;font-size:12px;font-weight:780}
      .field-hint{margin-top:-1px;color:#7b8a82;font-size:10px;line-height:1.5}
      .field em{font-style:normal;color:var(--danger);font-weight:900}
      .field input,.field textarea,.field select{
        width:100%;
        border:1px solid var(--line-strong);
        border-radius:13px;
        background:#fff;
        color:#1f2f27;
        outline:none;
        font-size:14px;
        box-shadow:0 1px 2px rgba(26,62,43,.025);
      }
      .field input,.field select{height:50px;padding:0 14px}
      .field textarea{min-height:126px;padding:13px 14px;resize:vertical;line-height:1.55}
      .field input::placeholder,.field textarea::placeholder{color:#a2aea8}
      .field input:hover,.field textarea:hover,.field select:hover{border-color:#adcbc0}
      .field input:focus,.field textarea:focus,.field select:focus{border-color:#5eae88;box-shadow:0 0 0 4px rgba(8,127,83,.09)}
      .check{grid-column:1/-1;min-height:56px;padding:13px 14px;display:flex!important;align-items:center;gap:11px;border:1px solid #dce8e1;border-radius:13px;background:#f8fbf9;cursor:pointer}
      .check:hover{border-color:#b8d4c5;background:#f4faf6}
      .check input{appearance:none;width:22px!important;height:22px!important;flex:0 0 auto;margin:0;padding:0!important;border:1.5px solid #aebeb5;border-radius:6px;background:#fff;display:grid;place-items:center;cursor:pointer}
      .check input:checked{border-color:var(--green);background:var(--green)}
      .check input:checked::after{content:"✓";color:#fff;font-size:13px;font-weight:900;line-height:1}
      .check span{font-size:13px!important;font-weight:750!important;color:#34453c}
      .error-wrap{grid-column:1/-1}
      .error{padding:12px 14px;border:1px solid #f0c7c1;border-radius:12px;background:var(--danger-soft);color:var(--danger);font-size:12px;line-height:1.55}
      .actions{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:4px;padding-top:22px;border-top:1px solid #edf2ef}
      .actions-copy{max-width:470px;color:#78877f;font-size:10px;line-height:1.55}
      .submit,.success-action{min-height:50px;min-width:190px;padding:0 22px;border:0;border-radius:13px;background:linear-gradient(180deg,#0a915e,#087f53);color:#fff;font-size:13px;font-weight:850;letter-spacing:.01em;cursor:pointer;box-shadow:0 8px 20px rgba(8,127,83,.18)}
      .submit:hover,.success-action:hover{transform:translateY(-1px);background:linear-gradient(180deg,#0b9c66,#08764e);box-shadow:0 10px 24px rgba(8,127,83,.24)}
      .submit:active,.success-action:active{transform:translateY(0)}
      .submit:disabled{opacity:.58;cursor:default;transform:none;box-shadow:none}
      .privacy{max-width:760px;margin:15px auto 0;text-align:center;color:#89968f;font-size:10px;line-height:1.6}
      .privacy a{color:#5d7568;text-underline-offset:2px}
      .state{min-height:390px;display:grid;place-items:center;text-align:center;padding:44px 28px;background:linear-gradient(180deg,#fff,#fbfdfc)}
      .state>div{max-width:500px}
      .state h2{margin:0 0 9px;color:#192820;font-size:25px;letter-spacing:-.03em}
      .state p{margin:0;color:var(--muted);font-size:13px;line-height:1.65}
      .spinner{width:40px;height:40px;margin:0 auto 18px;border:3px solid #dfece5;border-top-color:var(--green);border-radius:50%;animation:spin .8s linear infinite}
      .success-icon{width:62px;height:62px;margin:0 auto 18px;display:grid;place-items:center;border-radius:50%;background:var(--green-soft);color:var(--green);font-size:28px;font-weight:900;box-shadow:inset 0 0 0 1px #d4ebdf}
      .success-overlay{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;padding:22px;background:rgba(17,37,27,.42);backdrop-filter:blur(4px)}
      .success-overlay[hidden]{display:none!important}
      .success-dialog{width:min(460px,100%);padding:30px 28px 26px;border:1px solid #d4e6dc;border-radius:22px;background:#fff;text-align:center;box-shadow:0 28px 80px rgba(12,47,29,.24)}
      .success-dialog h2{margin:0 0 10px;font-size:25px;letter-spacing:-.03em;color:#17251f}
      .success-dialog p{margin:0;color:#53675c;font-size:13px;line-height:1.65}
      .success-dialog small{display:block;margin:12px 0 20px;color:#7b8a82;font-size:10px;line-height:1.5}
      .success-action{min-width:150px}
      @keyframes spin{to{transform:rotate(360deg)}}
      @media(max-width:720px){
        .page-shell{width:min(100% - 22px,980px);padding:16px 0 34px}
        .topbar{margin-bottom:14px;padding:0 3px}.brand img{width:32px;height:32px}.brand strong{font-size:18px}.secure-label{font-size:10px}.secure-label::before{width:20px;height:20px}
        .form-card{border-radius:18px}.head{padding:26px 20px 23px}.head h1{font-size:31px}.head p{font-size:13px}.meta{margin-top:16px}.meta span{font-size:10px}
        .form-body{padding:24px 20px 26px}.process-note{margin-bottom:22px}.form-intro{align-items:flex-start;flex-direction:column;gap:9px;margin-bottom:20px}.required-note{margin-top:0!important}
        form{grid-template-columns:1fr;gap:16px}.field.field-wide,.check,.error-wrap,.actions{grid-column:1}
        .actions{align-items:stretch;flex-direction:column-reverse;padding-top:20px}.actions-copy{text-align:center}.submit{width:100%;min-height:52px}
        .state{min-height:330px;padding:36px 20px}.state h2{font-size:23px}.success-dialog{padding:28px 20px 22px}.success-action{width:100%}
      }
      @media(max-width:420px){.secure-label span{display:none}.head h1{font-size:28px}.organization{font-size:10px}}
    </style>
  </head>
  <body>
    <main class="page-shell">
      <div class="topbar">
        <a class="brand" href="/" aria-label="Przydaś — strona główna"><img src="/przydas-mark.svg" alt="" /><strong>Przydaś</strong></a>
        <div class="secure-label"><span>Bezpieczny formularz wydarzenia</span></div>
      </div>
      <section class="form-card" id="card">
        <div class="state" id="loading"><div><div class="spinner"></div><h2>Ładujemy formularz</h2><p>Sprawdzamy link i przygotowujemy dane wydarzenia.</p></div></div>
      </section>
      <p class="privacy">Dane z formularza są przekazywane organizatorowi wydarzenia za pośrednictwem Przydasia. <a href="/polityka-prywatnosci/" target="_blank" rel="noopener">Polityka prywatności</a>.</p>
    </main>

    <div class="success-overlay" id="success-overlay" role="dialog" aria-modal="true" aria-labelledby="success-title" hidden>
      <div class="success-dialog">
        <div class="success-icon">✓</div>
        <h2 id="success-title">Formularz wysłany pomyślnie</h2>
        <p>Formularz został przekazany organizatorowi. Oczekuj na potwierdzenie rezerwacji.</p>
        <small>Wysłanie formularza nie oznacza jeszcze potwierdzenia terminu.</small>
        <button class="success-action" id="success-action" type="button">Gotowe</button>
      </div>
    </div>

    <script define:vars={{ apiUrl }}>
      const card = document.getElementById('card');
      const token = new URLSearchParams(window.location.search).get('t') || '';
      const successOverlay = document.getElementById('success-overlay');
      const successAction = document.getElementById('success-action');
      let formData = null;

      const esc = (value='') => String(value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[char]));
      const fmtDate = value => { if(!value) return ''; const d=new Date(value); return Number.isNaN(d.getTime())?'':new Intl.DateTimeFormat('pl-PL',{day:'2-digit',month:'2-digit',year:'numeric'}).format(d); };
      const placeholders = {
        title:'np. Urodziny Zosi',
        rodzaj_wydarzenia:'np. urodziny, piknik, warsztaty',
        adres:'Miejscowość, ulica, numer i kod pocztowy',
        osoba_do_kontaktu:'Imię i nazwisko',
        telefon_kontaktowy:'np. 500 000 000',
        email_kontaktowy:'np. kontakt@firma.pl',
        pakiet:'Nazwa wybranego pakietu',
        atrakcje:'Opisz ustalony zakres lub atrakcje',
        liczba_dzieci:'np. 20',
        wiek_dzieci:'np. 5–8 lat',
        solenizant:'Imię i wiek',
        typ_klienta:'np. osoba prywatna, firma, szkoła',
        kontrahent_nazwa:'Nazwa firmy lub instytucji',
        faktura_dane:'Nazwa / imię i nazwisko oraz adres do faktury',
        faktura_nip:'NIP (jeśli dotyczy)',
        sposob_platnosci:'np. przelew, gotówka',
        uwagi:'Dodatkowe informacje dla organizatora',
      };
      const fieldLabels = { title:'Nazwa wydarzenia' };
      const fieldHints = { adres:'Podaj dokładny adres z kodem pocztowym. Jeżeli dojazd jest niestandardowy, opisz to w uwagach na dole formularza.' };
      const wideKeys = new Set(['adres','atrakcje','faktura_dane','uwagi']);
      const timeSlotKeys = new Set(['godzina_start','godzina_end']);
      const timeOptions = Array.from({length:48},(_,index)=>{const total=index*30;const h=String(Math.floor(total/60)).padStart(2,'0');const m=String(total%60).padStart(2,'0');return `${h}:${m}`;});
      const plusTwoHours = value => { const match=/^(\d{2}):(\d{2})$/.exec(String(value||'')); if(!match)return ''; const total=(Number(match[1])*60+Number(match[2])+120)%(24*60); return `${String(Math.floor(total/60)).padStart(2,'0')}:${String(total%60).padStart(2,'0')}`; };
      const invoiceDependentKeys = new Set(['faktura_nip','faktura_dane']);
      const fieldOrder = [
        'title',
        'rodzaj_wydarzenia',
        'data_wydarzenia',
        'godzina_start',
        'godzina_end',
        'adres',
        'osoba_do_kontaktu',
        'telefon_kontaktowy',
        'email_kontaktowy',
        'typ_klienta',
        'kontrahent_nazwa',
        'pakiet',
        'atrakcje',
        'liczba_dzieci',
        'wiek_dzieci',
        'solenizant',
        'faktura_wymagana',
        'faktura_nip',
        'faktura_dane',
        'sposob_platnosci',
        'uwagi',
      ];
      const fieldOrderIndex = new Map(fieldOrder.map((key,index)=>[key,index]));
      const orderFields = fields => fields
        .map((field,index)=>({field,index}))
        .sort((a,b)=>{
          const aOrder = fieldOrderIndex.has(a.field.key) ? fieldOrderIndex.get(a.field.key) : (a.field.key === 'uwagi' ? 9999 : 9000 + a.index);
          const bOrder = fieldOrderIndex.has(b.field.key) ? fieldOrderIndex.get(b.field.key) : (b.field.key === 'uwagi' ? 9999 : 9000 + b.index);
          return aOrder - bOrder || a.index - b.index;
        })
        .map(item=>item.field);
      const callApi = async payload => {
        const response = await fetch(apiUrl,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload),credentials:'omit',cache:'no-store'});
        const data = await response.json().catch(()=>({ok:false,message:'Nieprawidłowa odpowiedź serwera.'}));
        if(!response.ok || data.ok===false) throw new Error(data.message || 'Nie udało się obsłużyć formularza.');
        return data;
      };
      const hideSuccessModal = () => { successOverlay.hidden=true;document.body.classList.remove('modal-open'); };
      const showState = (title,text,success=false) => {
        hideSuccessModal();
        card.innerHTML=`<div class="state"><div>${success?'<div class="success-icon">✓</div>':''}<h2>${esc(title)}</h2><p>${esc(text)}</p></div></div>`;
      };
      const showSuccessModal = () => {
        successOverlay.hidden=false;
        document.body.classList.add('modal-open');
        requestAnimationFrame(()=>successAction.focus());
      };
      successAction.addEventListener('click',()=>showState('Formularz wysłany','Formularz został przekazany organizatorowi. Oczekuj na potwierdzenie rezerwacji.',true));

      const renderField = (field,hasInvoiceToggle=false) => {
        const key=esc(field.key),label=esc(fieldLabels[field.key]||field.label||field.key),required=field.required===true?' required':'',mark=field.required===true?' <em>*</em>':'';
        const wide=wideKeys.has(field.key)||field.type==='textarea'?' field-wide':'';
        const invoiceDependent=hasInvoiceToggle&&invoiceDependentKeys.has(field.key);
        const dependentClass=invoiceDependent?' invoice-dependent':'';
        const dependentAttrs=invoiceDependent?' data-invoice-dependent="true" hidden':'';
        const placeholder=placeholders[field.key]?` placeholder="${esc(placeholders[field.key])}"`:'';
        const hint=fieldHints[field.key]?`<small class="field-hint">${esc(fieldHints[field.key])}</small>`:'';
        if(field.type==='checkbox') return `<label class="field check${dependentClass}"${dependentAttrs}><input type="checkbox" name="${key}"><span>${label}${mark}</span></label>`;
        if(field.type==='textarea') return `<label class="field${wide}${dependentClass}"${dependentAttrs}><span>${label}${mark}</span><textarea name="${key}"${required}${placeholder}></textarea>${hint}</label>`;
        if(timeSlotKeys.has(field.key)) return `<label class="field${wide}${dependentClass}"${dependentAttrs}><span>${label}${mark}</span><select name="${key}"${required}><option value="">Wybierz godzinę</option>${timeOptions.map(value=>`<option value="${value}">${value}</option>`).join('')}</select>${hint}</label>`;
        const allowed=['date','email','tel','number','text']; const type=allowed.includes(field.type)?field.type:'text';
        return `<label class="field${wide}${dependentClass}"${dependentAttrs}><span>${label}${mark}</span><input type="${type}" name="${key}"${required}${placeholder}${type==='email'?' autocomplete="email"':''}${type==='tel'?' autocomplete="tel"':''}>${hint}</label>`;
      };
      const wireInvoiceDependencies = form => {
        const toggle=form.elements.namedItem('faktura_wymagana');
        if(!toggle)return;
        const dependentFields=Array.from(form.querySelectorAll('[data-invoice-dependent="true"]'));
        const sync=()=>{
          const active=Boolean(toggle.checked);
          for(const wrapper of dependentFields){
            wrapper.hidden=!active;
            const control=wrapper.querySelector('input,textarea,select');
            if(!control)continue;
            control.disabled=!active;
            if(!active){if(control.type==='checkbox')control.checked=false;else control.value='';}
          }
        };
        toggle.addEventListener('change',sync);
        sync();
      };
      const wireTimeDefaults = form => {
        const start=form.elements.namedItem('godzina_start');
        const end=form.elements.namedItem('godzina_end');
        if(!start||!end)return;
        const sync=()=>{ if(!start.value)return; end.value=plusTwoHours(start.value); };
        start.addEventListener('change',sync);
      };
      const renderForm = data => {
        formData=data;
        if(data.completed){showState('Formularz został już przekazany',data.message||'Wszystko jest zapisane — nie musisz nic więcej robić.',true);return;}
        const fields=orderFields(Array.isArray(data.fields)?data.fields:[]);
        const hasInvoiceToggle=fields.some(field=>field?.key==='faktura_wymagana');
        card.innerHTML=`<header class="head"><span class="organization">${esc(data.organization_name||'Organizator')}</span><h1>${esc(data.template_name||'Informacje o wydarzeniu')}</h1><p>${esc(data.description||'Uzupełnij informacje dotyczące wydarzenia. Po wysłaniu trafią bezpośrednio do organizatora.')}</p><div class="meta">${data.expires_at?`<span>Link ważny do ${esc(fmtDate(data.expires_at))}</span>`:''}<span>Dane trafiają bezpośrednio do organizatora</span></div></header><div class="form-body"><div class="process-note"><strong>Jak wygląda dalszy proces?</strong><span>Uzupełnij i wyślij formularz. Organizator zweryfikuje dane, a po zaakceptowaniu rezerwacji otrzymasz potwierdzenie na podany adres e-mail. Jeśli coś będzie wymagało doprecyzowania, organizator skontaktuje się telefonicznie.</span><small>Wysłanie formularza nie oznacza jeszcze potwierdzenia rezerwacji.</small></div><div class="form-intro"><div><strong>Informacje o wydarzeniu</strong><span>Uzupełnij pola poniżej i wyślij formularz.</span></div><span class="required-note">* pola wymagane</span></div><form id="reservation-form">${fields.map(field=>renderField(field,hasInvoiceToggle)).join('')}<div id="form-error" class="error-wrap" aria-live="polite"></div><div class="actions"><div class="actions-copy">Przed wysłaniem możesz jeszcze sprawdzić wszystkie wpisane informacje.</div><button class="submit" type="submit">Wyślij formularz →</button></div></form></div>`;
        const form=document.getElementById('reservation-form');
        wireInvoiceDependencies(form);
        wireTimeDefaults(form);
        form.addEventListener('submit',submitForm);
      };
      const submitForm = async event => {
        event.preventDefault();
        const form=event.currentTarget,button=form.querySelector('.submit'),errorBox=document.getElementById('form-error');
        if(!form.reportValidity()) return;
        const answers={};
        for(const field of (formData?.fields||[])){
          const input=form.elements.namedItem(field.key); if(!input)continue;
          if(input.disabled&&invoiceDependentKeys.has(field.key)){answers[field.key]='';continue;}
          answers[field.key]=field.type==='checkbox'?Boolean(input.checked):String(input.value||'').trim();
        }
        button.disabled=true;button.textContent='Wysyłanie…';errorBox.innerHTML='';
        try{
          await callApi({action:'submit',token,answers});
          for(const control of form.elements)control.disabled=true;
          button.textContent='Formularz wysłany';
          showSuccessModal();
        }
        catch(error){errorBox.innerHTML=`<div class="error">${esc(error.message||'Nie udało się wysłać formularza.')}</div>`;button.disabled=false;button.textContent='Wyślij formularz →';}
      };
      (async()=>{
        if(token.length<30){showState('Nieprawidłowy link','Poproś organizatora o ponowne przesłanie formularza.');return;}
        try{renderForm(await callApi({action:'get',token}));}catch(error){showState('Formularz jest niedostępny',error.message||'Link wygasł lub został unieważniony.');}
      })();
    </script>
  </body>
</html>