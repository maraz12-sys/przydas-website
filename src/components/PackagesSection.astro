---
const plans = [
  {
    name: 'START',
    monthlyPrice: '59 zł',
    annualPrice: '590 zł',
    annualMonthly: '49,17 zł',
    annualSaving: '118 zł',
    kicker: 'Porządek na co dzień',
    title: 'Ogarnij rezerwacje i podstawową organizację.',
    description: 'Dla firmy, która chce zebrać kalendarz, zespół i najważniejsze dane operacyjne w jednym miejscu.',
    featured: false,
    bullets: [
      'Kalendarz i pełna obsługa rezerwacji',
      'Dyspozycyjność, przypisania i potwierdzenia',
      'Podstawowe powiadomienia i braki w rezerwacji',
      'Tworzenie i zarządzanie zespołem',
      'Notatnik Przydasia',
      'Podstawowy panel rozliczeń',
    ],
    note: '1 firma · częściowa konfiguracja formularza',
  },
  {
    name: 'ZESPÓŁ',
    monthlyPrice: '149 zł',
    annualPrice: '1 490 zł',
    annualMonthly: '124,17 zł',
    annualSaving: '298 zł',
    kicker: 'Więcej ludzi, mniej pilnowania',
    title: 'Zarządzaj zespołem i przygotowaniem realizacji.',
    description: 'Dla rozwijającej się firmy, w której samo zapisanie terminu już nie wystarcza.',
    featured: true,
    bullets: [
      'Wszystko z pakietu START',
      'Dni kluczowe i osoba odpowiedzialna',
      'Ankiety po wydarzeniach i wszystkie powiadomienia',
      'Stanowiska, zadania, garderoba i rozliczenia pracowników',
      'Checklisty, standardy, instrukcje i współdzielone notatki',
      'Podstawowe statystyki i 1 kategoria magazynowa',
    ],
    note: 'Do 3 firm · backup · pełna konfiguracja formularza',
  },
  {
    name: 'BIZNES',
    monthlyPrice: '199 zł',
    annualPrice: '1 990 zł',
    annualMonthly: '165,83 zł',
    annualSaving: '398 zł',
    kicker: 'Pełna kontrola firmy',
    title: 'Rozliczaj, analizuj i podejmuj decyzje na danych.',
    description: 'Dla firmy, która chce kontrolować materiały, finanse, proces po evencie i rozwój całej organizacji.',
    featured: false,
    business: true,
    bullets: [
      'Wszystko z pakietu ZESPÓŁ',
      'Checklisty materiałowe i zakupowe',
      'Braki dotyczące materiałów i rozliczeń',
      'Asystent AI, podwykonawcy i nielimitowany magazyn',
      'Faktury, integracja z programem fakturowym i eksport do Excela',
      'Zaawansowane statystyki klientów, wydarzeń i źródeł zleceń',
    ],
    note: 'Nielimitowane firmy · zaawansowane uprawnienia i automatyzacje',
  },
];
---

<section class="packages-section" id="cennik" data-billing="monthly">
  <div class="shell packages-shell">
    <div class="section-head packages-head">
      <span class="eyebrow-text">Pakiety Przydasia</span>
      <h2>Wybierasz poziom, nie nowy system.</h2>
      <p>
        Każdy wyższy pakiet zawiera funkcje niższego. Zaczynasz od tego, czego potrzebujesz dzisiaj,
        a wraz z rozwojem firmy odblokowujesz kolejne możliwości bez przenoszenia danych i zmiany narzędzia.
      </p>

      <div class="pricing-controls">
        <div class="billing-toggle" role="group" aria-label="Sposób rozliczenia" data-billing-toggle>
          <button type="button" class="active" data-billing-value="monthly" aria-pressed="true">Miesięcznie</button>
          <button type="button" data-billing-value="annual" aria-pressed="false">
            Rocznie <span>2 mies. gratis</span>
          </button>
        </div>
        <div class="annual-banner">
          <span class="annual-banner-badge">2 MIESIĄCE GRATIS</span>
          <span>Przy płatności z góry za 12 miesięcy płacisz tylko za 10.</span>
        </div>
      </div>
    </div>

    <div class="packages-grid">
      {plans.map((plan) => (
        <article class:list={['package-card', plan.featured && 'package-card-featured', plan.business && 'package-card-business']}>
          {plan.featured && <span class="package-recommended">NAJCZĘŚCIEJ WYBIERANY</span>}
          <div class="package-top">
            <span class="package-name">{plan.name}</span>
            <span class="package-kicker">{plan.kicker}</span>
          </div>

          <div class="package-price-row monthly-only">
            <strong class="package-price">{plan.monthlyPrice}</strong>
            <span class="package-period">brutto / miesiąc</span>
          </div>
          <div class="package-price-row annual-only" aria-hidden="true">
            <strong class="package-price">{plan.annualPrice}</strong>
            <span class="package-period">brutto / rok</span>
          </div>

          <div class="annual-offer">
            <div class="monthly-only">
              <span class="annual-label">Przy płatności rocznej</span>
              <strong>{plan.annualPrice} brutto / rok</strong>
            </div>
            <div class="annual-only" aria-hidden="true">
              <span class="annual-label">Efektywnie miesięcznie</span>
              <strong>{plan.annualMonthly} brutto / mies.</strong>
            </div>
            <span class="annual-saving">Oszczędzasz {plan.annualSaving}</span>
          </div>

          <h3>{plan.title}</h3>
          <p class="package-description">{plan.description}</p>
          <div class="package-divider"></div>
          <ul class="package-list">
            {plan.bullets.map((bullet) => (
              <li><span>✓</span><b>{bullet}</b></li>
            ))}
          </ul>
          <div class="package-note">{plan.note}</div>
          <a
            class:list={['button', plan.featured || plan.business ? 'button-primary' : 'button-secondary', 'package-button']}
            href="#start"
            data-plan={plan.name}
          >
            Wybieram {plan.name} <span>→</span>
          </a>
        </article>
      ))}
    </div>

    <div class="package-comparison">
      <div>
        <strong>Chcesz porównać wszystko punkt po punkcie?</strong>
        <span>Niżej znajdziesz pełną tabelę funkcji, limitów i różnic między START, ZESPÓŁ i BIZNES.</span>
      </div>
      <a href="#porownanie">Pełne porównanie pakietów <span>→</span></a>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector('.packages-section[data-billing]');
    if (!section) return;
    const buttons = section.querySelectorAll('[data-billing-value]');

    const setBilling = (value) => {
      section.setAttribute('data-billing', value);
      buttons.forEach((button) => {
        const active = button.getAttribute('data-billing-value') === value;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      section.querySelectorAll('.monthly-only').forEach((element) => {
        element.setAttribute('aria-hidden', String(value !== 'monthly'));
      });
      section.querySelectorAll('.annual-only').forEach((element) => {
        element.setAttribute('aria-hidden', String(value !== 'annual'));
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => setBilling(button.getAttribute('data-billing-value') || 'monthly'));
    });
  })();
</script>

<style>
  .packages-section { padding: 112px 0; background: #f5f9f7; }
  .packages-head { max-width: 900px; }
  .pricing-controls { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .billing-toggle { display: inline-flex; padding: 4px; border: 1px solid #d5e5dc; border-radius: 14px; background: #fff; box-shadow: 0 8px 24px rgba(28,74,52,.05); }
  .billing-toggle button { min-height: 42px; padding: 0 15px; border: 0; border-radius: 10px; background: transparent; color: #68766f; font: inherit; font-size: 12px; font-weight: 800; cursor: pointer; transition: background .18s ease, color .18s ease, box-shadow .18s ease; }
  .billing-toggle button span { margin-left: 5px; color: #078a59; font-size: 9px; font-weight: 900; }
  .billing-toggle button.active { background: #078a59; color: #fff; box-shadow: 0 7px 16px rgba(7,138,89,.18); }
  .billing-toggle button.active span { color: #c9f3df; }
  .annual-banner { width: fit-content; padding: 10px 14px; border: 1px solid #bde7d2; border-radius: 14px; display: flex; align-items: center; gap: 10px; background: #edf9f3; color: #426254; font-size: 13px; font-weight: 650; }
  .annual-banner-badge { padding: 6px 9px; border-radius: 999px; background: #078a59; color: #fff; font-size: 9px; font-weight: 900; letter-spacing: .07em; }
  .packages-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; align-items: stretch; }
  .package-card { position: relative; display: flex; flex-direction: column; min-height: 760px; padding: 30px; border-radius: 24px; border: 1px solid #dce7e1; background: #fff; box-shadow: 0 16px 42px rgba(28,74,52,.05); }
  .package-card-featured { transform: translateY(-10px); border-color: #88dbb4; box-shadow: 0 24px 52px rgba(18,173,112,.12); }
  .package-card-business { border-color: #73cfa4; background: linear-gradient(160deg, #f1fbf6, #e5f7ee); }
  .package-recommended { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); padding: 7px 12px; border-radius: 999px; white-space: nowrap; color: #fff; background: #078a59; font-size: 9px; font-weight: 850; letter-spacing: .07em; }
  .package-top { min-height: 70px; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .package-name { display: inline-flex; padding: 8px 11px; border-radius: 999px; color: #087f53; background: #eaf8f2; font-size: 11px; font-weight: 900; letter-spacing: .08em; }
  .package-card-business .package-name { color: #fff; background: #078a59; }
  .package-kicker { color: #86938c; font-size: 12px; font-weight: 700; }
  .package-price-row { display: flex; align-items: baseline; gap: 7px; margin: 12px 0; }
  .package-price { font-size: 42px; line-height: 1; letter-spacing: -.05em; }
  .package-period { color: #7d8a83; font-size: 13px; font-weight: 650; }
  .annual-only { display: none !important; }
  .packages-section[data-billing='annual'] .monthly-only { display: none !important; }
  .packages-section[data-billing='annual'] .annual-only { display: flex !important; }
  .packages-section[data-billing='annual'] .annual-offer .annual-only { display: grid !important; }
  .annual-offer { margin-bottom: 20px; padding: 13px 14px; border: 1px solid #d9ebe2; border-radius: 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px; background: rgba(234,248,242,.7); }
  .annual-offer > div { display: grid; gap: 3px; }
  .annual-label { color: #74847b; font-size: 10px; font-weight: 750; text-transform: uppercase; letter-spacing: .06em; }
  .annual-offer strong { font-size: 13px; letter-spacing: -.01em; }
  .annual-saving { flex: 0 0 auto; padding: 6px 8px; border-radius: 999px; color: #078a59; background: #fff; font-size: 10px; font-weight: 850; }
  .package-card h3 { margin: 0 0 14px; font-size: 27px; line-height: 1.08; letter-spacing: -.04em; }
  .package-description { min-height: 112px; margin: 0; color: #6f7a74; font-size: 14px; line-height: 1.55; }
  .package-divider { height: 1px; margin: 24px 0; background: #e4ece8; }
  .package-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  .package-list li { display: grid; grid-template-columns: 23px 1fr; gap: 10px; align-items: start; font-size: 13px; line-height: 1.42; }
  .package-list li span { width: 23px; height: 23px; display: grid; place-items: center; border-radius: 8px; color: #078a59; background: #eaf8f2; font-size: 11px; font-weight: 900; }
  .package-list li b { font-weight: 680; }
  .package-note { margin-top: auto; padding-top: 26px; color: #7f8c85; font-size: 11px; line-height: 1.45; }
  .package-button { width: 100%; margin-top: 18px; }
  .package-comparison { margin-top: 28px; padding: 26px 28px; border-radius: 20px; display: flex; align-items: center; justify-content: space-between; gap: 28px; background: #fff; border: 1px solid #dfe8e3; }
  .package-comparison div { display: grid; gap: 5px; }
  .package-comparison strong { font-size: 15px; }
  .package-comparison span { color: #6f7a74; font-size: 12px; line-height: 1.45; }
  .package-comparison > a { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 10px; color: #078a59; font-size: 13px; font-weight: 800; }

  @media (max-width: 900px) {
    .packages-grid { grid-template-columns: 1fr; }
    .package-card { min-height: auto; }
    .package-card-featured { transform: none; }
    .package-description { min-height: auto; }
  }

  @media (max-width: 640px) {
    .packages-section { padding: 76px 0; }
    .pricing-controls { align-items: stretch; flex-direction: column; }
    .billing-toggle { width: 100%; }
    .billing-toggle button { flex: 1; padding-inline: 10px; }
    .annual-banner { width: 100%; align-items: flex-start; flex-direction: column; }
    .package-card { padding: 24px; }
    .package-price { font-size: 38px; }
    .annual-offer { align-items: flex-start; flex-direction: column; }
    .package-card h3 { font-size: 24px; }
    .package-comparison { align-items: flex-start; flex-direction: column; }
  }
</style>
