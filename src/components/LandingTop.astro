---
const problems = [
  {
    no: '01',
    title: 'Informacje są wszędzie',
    text: 'Kalendarz, Messenger, notatki i arkusze. Jedno zlecenie potrafi żyć w kilku miejscach naraz.',
    loss: 'Koszt: szukanie, przepisywanie i pomyłki.',
  },
  {
    no: '02',
    title: 'Właściciel pilnuje wszystkich',
    text: 'Kto może pracować? Kto potwierdził? Kto ma zadanie? Zamiast prowadzić firmę, prowadzisz kolejne rozmowy.',
    loss: 'Koszt: Twój czas i ciągłe przerywanie pracy.',
  },
  {
    no: '03',
    title: 'Braki wychodzą za późno',
    text: 'Materiał, informacja od klienta albo rozliczenie przypominają o sobie wtedy, kiedy zaczyna być nerwowo.',
    loss: 'Koszt: zakupy na ostatnią chwilę i niepotrzebne straty.',
  },
  {
    no: '04',
    title: 'Dobry klient znika po evencie',
    text: 'Realizacja się kończy, kontakt zostaje w historii wiadomości, a przy kolejnej okazji klient może po prostu szukać od nowa.',
    loss: 'Koszt: sprzedaż, o którą nikt ponownie nie zapytał.',
  },
];

const capabilities = [
  ['Rezerwacje bez szukania', 'Termin, klient, ustalenia, status i szczegóły wydarzenia w jednym miejscu.'],
  ['Zespół bez setek wiadomości', 'Dyspozycyjność, przypisania, potwierdzenia, zadania i odpowiedzialność są widoczne od razu.'],
  ['Braki zanim staną się problemem', 'System przypomina o rzeczach, których nie warto trzymać w głowie.'],
  ['Firma po evencie też pracuje', 'Rozliczenia, feedback, statystyki i historia klienta nie znikają wraz z zakończeniem realizacji.'],
];

const beforeEvent = [
  {
    no: '01',
    title: 'Przyjmujesz rezerwację',
    text: 'Najważniejsze dane klienta i wydarzenia od początku trafiają do jednego procesu.',
  },
  {
    no: '02',
    title: 'System zbiera gotowość',
    text: 'Dyspozycyjność, przypisania, potwierdzenia i braki nie wymagają ciągłego przekopywania wiadomości.',
  },
  {
    no: '03',
    title: 'Zespół wie, co robić',
    text: 'Role, zadania, instrukcje i odpowiedzialność są dostępne tam, gdzie zespół ich potrzebuje.',
  },
];

const afterEvent = [
  {
    no: '04',
    title: 'Zbierasz feedback',
    text: 'Po realizacji zostają informacje o przebiegu, brakach, uszkodzeniach i jakości zlecenia.',
  },
  {
    no: '05',
    title: 'Zamykasz rozliczenie',
    text: 'Pracownicy, płatności i dane potrzebne do zamknięcia zlecenia nie wiszą tygodniami w pamięci.',
  },
  {
    no: '06',
    title: 'Widzisz liczby',
    text: 'Dane z wydarzeń budują statystyki, które pokazują wyniki, źródła zleceń i rentowność.',
  },
  {
    no: '07',
    title: 'Wracasz do klienta',
    text: 'Historia współpracy zostaje w systemie, dzięki czemu łatwiej przypomnieć się przed kolejną okazją.',
  },
];

const audiences = [
  {
    plan: 'START',
    eyebrow: 'Chcesz wreszcie mieć porządek',
    title: 'Przestań szukać informacji',
    text: 'Dla małej firmy, która chce zebrać rezerwacje, podstawową pracę zespołu i najważniejsze dane w jednym miejscu.',
    result: 'Efekt: mniej chaosu i mniej rzeczy trzymanych w głowie.',
  },
  {
    plan: 'ZESPÓŁ',
    eyebrow: 'Masz ludzi i za dużo pilnowania',
    title: 'Odzyskaj czas właściciela',
    text: 'Dla firmy, w której dyspozycyjność, potwierdzenia, zadania i rozliczenia pracowników zaczynają zabierać realne godziny.',
    result: 'Efekt: mniej wiadomości i mniej ręcznego koordynowania.',
  },
  {
    plan: 'BIZNES',
    eyebrow: 'Chcesz zarządzać wynikiem, nie tylko kalendarzem',
    title: 'Pilnuj pieniędzy i klientów',
    text: 'Dla firmy, która chce kontrolować koszty, materiały, wyniki, dane po realizacji i powroty do byłych klientów.',
    result: 'Efekt: decyzje oparte na danych i więcej okazji do ponownej sprzedaży.',
  },
];
---

<header class="site-header">
  <div class="shell nav-wrap">
    <a href="#top" class="brand" aria-label="Przydaś — strona główna">
      <span class="brand-mark" aria-hidden="true"><img src="/przydas-mark.svg" alt="" /></span>
      <span>Przydaś</span>
    </a>

    <nav class="nav-links" aria-label="Nawigacja główna">
      <a href="#korzysci">Korzyści</a>
      <a href="#jak-dziala">Jak działa</a>
      <a href="#cennik">Cennik</a>
      <a href="#porownanie">Porównanie</a>
      <a href="#faq">FAQ</a>
    </nav>

    <div class="nav-actions">
      <a class="login-link" href="https://app.xn--przyda-8ib.pl/">Zaloguj się</a>
      <a class="button button-primary button-small" href="#cennik">Zobacz pakiety <span>→</span></a>
    </div>
  </div>
</header>

<section class="hero shell" id="top">
  <div class="hero-copy">
    <div class="eyebrow-pill">
      <span>✣</span>
      System stworzony dla firm animacyjnych
    </div>

    <h1>Mniej pilnowania.<br /><span>Więcej czasu na firmę.</span></h1>
    <p class="hero-lead">
      Przydaś łączy rezerwacje, kalendarz, zespół, braki, rozliczenia i dane po realizacji.
      Zamiast pamiętać o wszystkim samemu, budujesz proces, który pomaga oszczędzać czas, ograniczać straty i wracać do klientów.
    </p>

    <div class="hero-actions">
      <a class="button button-primary" href="#cennik">Sprawdź, ile to kosztuje <span>→</span></a>
      <a class="button button-secondary" href="#jak-dziala">Zobacz cały proces <span>↓</span></a>
    </div>

    <div class="hero-benefits" aria-label="Najważniejsze korzyści">
      <span>✓ mniej ręcznej pracy</span>
      <span>✓ mniej kosztownych braków</span>
      <span>✓ więcej kontroli nad klientami</span>
    </div>
  </div>

  <div class="hero-visual" aria-label="Przykładowy panel Przydasia">
    <div class="app-window hero-app">
      <div class="app-topbar">
        <div class="app-topbar-title"><span class="status-dot"></span> Dzisiaj w firmie</div>
        <div class="avatar-icon">P</div>
      </div>

      <div class="app-body">
        <aside class="app-sidebar">
          <strong>Przegląd</strong>
          <span>Eventy</span>
          <span>Zespół</span>
          <span>Klienci</span>
          <span>Rozliczenia</span>
        </aside>

        <div class="dashboard">
          <div class="dashboard-head">
            <div>
              <span class="muted-label">Najważniejsze teraz</span>
              <h3>Firma pod kontrolą</h3>
            </div>
            <span class="today-chip">3 eventy</span>
          </div>

          <div class="event-card">
            <div>
              <strong>Piknik firmowy</strong>
              <span>15:30 · 6 osób · komplet danych</span>
            </div>
            <span class="ready-chip">Zespół gotowy</span>
          </div>

          <div class="event-card event-card-alert">
            <div>
              <strong>Urodziny Mai</strong>
              <span>Jutro · brak 1 potwierdzenia</span>
            </div>
            <span class="attention-chip">Do sprawdzenia</span>
          </div>

          <div class="customer-return-card">
            <div>
              <span class="muted-label">Klient po realizacji</span>
              <strong>Centrum Kultury</strong>
              <small>Ostatnie zlecenie: 11 mies. temu</small>
            </div>
            <span class="return-chip">Warto wrócić</span>
          </div>

          <div class="dashboard-stats">
            <div><b>0</b><span>pilnych braków</span></div>
            <div><b>8</b><span>osób aktywnych</span></div>
            <div><b>1</b><span>kontakt do powrotu</span></div>
          </div>
        </div>
      </div>
    </div>
    <div class="visual-glow"></div>
  </div>
</section>

<section class="proof-strip" aria-label="Założenia Przydasia">
  <div class="shell proof-strip-inner">
    <strong>Nie kolejny CRM „dla każdego”.</strong>
    <span>Przydaś powstaje wokół realnego cyklu firmy animacyjnej: rezerwacja → zespół → realizacja → rozliczenie → klient → dane.</span>
  </div>
</section>

<section class="problem-section" id="korzysci">
  <div class="shell">
    <div class="section-head problem-head">
      <span class="eyebrow-text">Chaos nie jest darmowy</span>
      <h2>Każde „ogarnę później” kosztuje czas albo pieniądze.</h2>
      <p>
        Największym kosztem nie musi być abonament za narzędzie. Często są nim godziny właściciela, błędy na ostatnią chwilę,
        niepotrzebne zakupy i klienci, do których nikt już nie wrócił.
      </p>
    </div>

    <div class="problem-grid">
      {problems.map((problem) => (
        <article class="problem-card">
          <span class="problem-number">{problem.no}</span>
          <h3>{problem.title}</h3>
          <p>{problem.text}</p>
          <strong>{problem.loss}</strong>
        </article>
      ))}
    </div>

    <div class="section-transition">
      <strong>Przydaś ma zdejmować z Ciebie pracę, a nie dokładać kolejnej aplikacji do obsługi.</strong>
      <span class="transition-line"></span>
      <a href="#funkcje" aria-label="Przejdź do funkcji">→</a>
    </div>
  </div>
</section>

<section class="solution-section" id="funkcje">
  <div class="shell">
    <div class="section-head section-head-narrow">
      <span class="eyebrow-text">Jedno źródło prawdy</span>
      <h2>To, co dziś pilnujesz ręcznie, zamieniasz w proces.</h2>
      <p>
        Przydaś prowadzi zlecenie od pierwszego kontaktu do danych po realizacji. Dzięki temu mniej rzeczy zależy od pamięci właściciela
        i od tego, czy ktoś odnalazł właściwą wiadomość na Messengerze.
      </p>
    </div>

    <div class="solution-grid">
      <div class="product-preview">
        <div class="preview-head">
          <div><span class="status-dot"></span> Przydaś · jedno miejsce</div>
          <span class="ready-chip">✓ proces zamiast pamięci</span>
        </div>
        <div class="preview-content">
          <div class="preview-events">
            <div class="preview-label">Plan pracy <span>automatycznie aktualny</span></div>
            <div class="mini-event active"><strong>Rezerwacja</strong><span>klient · termin · ustalenia</span></div>
            <div class="mini-event"><strong>Przygotowanie</strong><span>zespół · zadania · braki</span></div>
            <div class="mini-event"><strong>Po realizacji</strong><span>rozliczenie · feedback · klient</span></div>
          </div>
          <div class="preview-team">
            <div class="preview-label">Status</div>
            <div class="team-row"><span class="team-dot strong"></span> Dane kompletne</div>
            <div class="team-row"><span class="team-dot strong"></span> Zespół gotowy</div>
            <div class="team-row"><span class="team-dot pale"></span> 1 kontakt później</div>
          </div>
        </div>
      </div>

      <div class="capabilities">
        {capabilities.map(([title, text]) => (
          <article class="capability">
            <span class="capability-icon">✓</span>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))}
        <a class="button button-secondary capability-cta" href="#jak-dziala">Zobacz krok po kroku <span>→</span></a>
      </div>
    </div>
  </div>
</section>

<section class="lifecycle-section" id="jak-dziala">
  <div class="shell">
    <div class="section-head lifecycle-head">
      <span class="eyebrow-text">Event to nie tylko dzień realizacji</span>
      <h2>Przed eventem porządek.<br />Po evencie pieniądze i wiedza.</h2>
      <p>
        Większość narzędzi pomaga zapisać termin. Przydaś ma obsłużyć cały cykl: przygotowanie, realizację,
        zamknięcie finansowe, analizę i kolejny kontakt z klientem.
      </p>
    </div>

    <div class="phase-block before-phase">
      <div class="phase-header">
        <div>
          <span class="phase-kicker">PRZED WYDARZENIEM</span>
          <h3>Najpierw zdejmujesz chaos operacyjny.</h3>
        </div>
      </div>
      <div class="phase-grid phase-grid-three">
        {beforeEvent.map((step) => (
          <article class="lifecycle-card">
            <span class="step-number">{step.no}</span>
            <h4>{step.title}</h4>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="phase-bridge" aria-hidden="true">
      <span>REALIZACJA</span>
    </div>

    <div class="phase-block after-phase">
      <div class="phase-header">
        <div>
          <span class="phase-kicker">PO WYDARZENIU · TU ZACZYNA SIĘ BIZNES</span>
          <h3>Event się kończy. Wartość danych dopiero zaczyna rosnąć.</h3>
        </div>
      </div>
      <div class="phase-grid phase-grid-four">
        {afterEvent.map((step) => (
          <article class="lifecycle-card post-event">
            <span class="step-number">{step.no}</span>
            <h4>{step.title}</h4>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="business-value">
      <div class="business-value-copy">
        <span class="eyebrow-text">Nie zgadujesz — widzisz</span>
        <h3>Z każdego eventu zostaje coś więcej niż zdjęcia.</h3>
        <p>
          Zlecenia budują historię klientów, rozliczenia i statystyki. Z czasem widzisz, które źródła dają najlepszych klientów,
          na czym zarabiasz i do kogo warto odezwać się ponownie.
        </p>
      </div>
      <div class="stats-demo" aria-label="Przykładowe informacje biznesowe">
        <div class="stat-box"><span>Wynik okresu</span><strong>W jednym widoku</strong><em>przychody i koszty</em></div>
        <div class="stat-box"><span>Źródła zleceń</span><strong>Porównywalne</strong><em>wiesz, co dowozi klientów</em></div>
        <div class="stat-box wide"><span>Klienci po realizacji</span><strong>Nie znikają w archiwum</strong><em>historia współpracy zostaje w systemie</em></div>
      </div>
    </div>
  </div>
</section>

<section class="audience-section" id="dla-kogo">
  <div class="shell">
    <div class="section-head audience-head">
      <span class="eyebrow-text">Kupujesz efekt, nie listę funkcji</span>
      <h2>Wybierz problem, który dziś kosztuje Cię najwięcej.</h2>
      <p>
        Nie musisz kupować wszystkiego na start. Pakiety są ułożone tak, żeby firma mogła zacząć od porządku,
        potem odzyskać czas właściciela, a na końcu dołożyć kontrolę nad wynikiem i klientami.
      </p>
    </div>

    <div class="audience-grid">
      {audiences.map((audience, index) => (
        <article class:list={['audience-card', index === 1 && 'audience-card-featured', index === 2 && 'audience-card-business']}>
          <div class="audience-top">
            <span class="audience-plan">{audience.plan}</span>
            <span class="audience-eyebrow">{audience.eyebrow}</span>
          </div>
          <h3>{audience.title}</h3>
          <p>{audience.text}</p>
          <strong class="audience-result">{audience.result}</strong>
        </article>
      ))}
    </div>

    <div class="audience-cta">
      <div>
        <strong>Nie pytaj najpierw „ile funkcji dostaję?”.</strong>
        <span>Zapytaj: ile godzin, pomyłek albo utraconych okazji ten pakiet może zdjąć z mojej firmy?</span>
      </div>
      <a class="button button-primary" href="#cennik">Policz i zobacz pakiety <span>→</span></a>
    </div>
  </div>
</section>

<div class="mobile-cta" aria-label="Szybki dostęp do cennika">
  <span><strong>Przydaś</strong><small>od 59 zł / mies.</small></span>
  <a href="#cennik">Zobacz pakiety →</a>
</div>

<style is:global>
  :root {
    --green: #12ad70;
    --green-dark: #078a59;
    --green-soft: #eaf8f2;
    --green-softer: #f5fbf8;
    --ink: #13201a;
    --muted: #66756d;
    --line: #dfe7e2;
    --surface: #ffffff;
    --soft: #f6f9f7;
    --radius: 24px;
    --shadow: 0 22px 55px rgba(20, 72, 48, 0.09);
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 100px; }
  body {
    margin: 0;
    color: var(--ink);
    background: #fff;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, h4, p { margin-top: 0; }
  button, input, select { font: inherit; }
  .shell { width: min(1120px, calc(100% - 48px)); margin-inline: auto; }
  :focus-visible { outline: 3px solid rgba(18,173,112,.42); outline-offset: 3px; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255,255,255,.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(223,231,226,.72);
  }
  .nav-wrap { min-height: 82px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 22px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; width: fit-content; font-size: 22px; font-weight: 850; letter-spacing: -.025em; }
  .brand-mark { width: 33px; height: 33px; border-radius: 10px; overflow: hidden; display: grid; place-items: center; box-shadow: 0 8px 18px rgba(20,72,48,.08); }
  .brand-mark img { display: block; width: 33px; height: 33px; }
  .nav-links { display: flex; align-items: center; gap: 27px; font-size: 14px; font-weight: 680; }
  .nav-links a, .login-link { transition: color .18s ease; }
  .nav-links a:hover, .login-link:hover { color: var(--green-dark); }
  .nav-actions { justify-self: end; display: flex; gap: 20px; align-items: center; font-size: 14px; font-weight: 680; }

  .button { min-height: 50px; padding: 0 20px; border-radius: 13px; display: inline-flex; align-items: center; justify-content: center; gap: 13px; font-weight: 780; font-size: 15px; transition: transform .18s ease, box-shadow .18s ease, background .18s ease; }
  .button:hover { transform: translateY(-2px); }
  .button-primary { color: #fff; background: var(--green); box-shadow: 0 12px 26px rgba(18,173,112,.2); }
  .button-primary:hover { background: var(--green-dark); box-shadow: 0 14px 30px rgba(18,173,112,.24); }
  .button-secondary { background: #fff; border: 1px solid var(--line); }
  .button-small { min-height: 44px; padding-inline: 18px; }

  .hero { min-height: 690px; padding-block: 74px 82px; display: grid; grid-template-columns: .98fr 1.02fr; gap: 66px; align-items: center; }
  .eyebrow-pill { display: inline-flex; align-items: center; gap: 8px; padding: 9px 13px; border-radius: 999px; background: var(--green-soft); color: var(--green-dark); font-size: 13px; font-weight: 780; }
  .hero h1 { margin: 28px 0 24px; font-size: clamp(52px, 5.2vw, 74px); line-height: .98; letter-spacing: -.058em; font-weight: 860; }
  .hero h1 span { color: var(--green-dark); }
  .hero-lead { max-width: 610px; color: var(--muted); font-size: 18px; line-height: 1.62; letter-spacing: -.012em; }
  .hero-actions { margin-top: 30px; display: flex; gap: 12px; flex-wrap: wrap; }
  .hero-benefits { margin-top: 24px; display: flex; gap: 10px 18px; flex-wrap: wrap; color: #65766d; font-size: 12px; font-weight: 720; }
  .hero-benefits span { display: inline-flex; align-items: center; gap: 6px; }

  .hero-visual { position: relative; }
  .visual-glow { position: absolute; z-index: -1; inset: 12% -6% -7% 10%; background: radial-gradient(circle at center, rgba(18,173,112,.17), rgba(18,173,112,0) 65%); filter: blur(10px); }
  .app-window { overflow: hidden; border: 1px solid #d9e8df; border-radius: 25px; background: #fff; box-shadow: var(--shadow); }
  .hero-app { transform: perspective(1200px) rotateY(-1deg) rotateX(.35deg); }
  .app-topbar { height: 68px; padding: 0 22px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
  .app-topbar-title { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 780; }
  .status-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--green); display: inline-block; }
  .avatar-icon { width: 34px; height: 34px; border-radius: 11px; background: var(--green-soft); color: var(--green-dark); display: grid; place-items: center; font-size: 13px; font-weight: 850; }
  .app-body { min-height: 430px; display: grid; grid-template-columns: 116px 1fr; }
  .app-sidebar { padding: 23px 15px; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 16px; color: #758078; font-size: 11px; }
  .app-sidebar strong { color: var(--green-dark); }
