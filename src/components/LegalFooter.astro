---
const legalCards = [
  {
    eyebrow: 'Kontakt',
    title: 'Wiesz, gdzie napisać.',
    text: 'Sprzedaż, wsparcie i bezpieczeństwo mają osobne adresy. Bez szukania formularzy po całej stronie.',
    links: [
      ['Sprzedaż', 'mailto:sprzedaz@xn--przyda-8ib.pl'],
      ['Wsparcie', 'mailto:wsparcie@xn--przyda-8ib.pl'],
      ['Pełny kontakt', '/kontakt'],
    ],
  },
  {
    eyebrow: 'Prywatność i RODO',
    title: 'Jasno rozdzielamy role.',
    text: 'Inaczej traktujemy dane konta Przydasia, a inaczej dane klientów i pracowników wprowadzane przez Twoją firmę.',
    links: [
      ['Polityka prywatności', '/polityka-prywatnosci'],
      ['Cookies i storage', '/cookies'],
      ['Podprocesorzy', '/podprocesorzy'],
    ],
  },
  {
    eyebrow: 'Bezpieczeństwo',
    title: 'Bez obietnic „zera ryzyka”.',
    text: 'Pokazujemy faktyczny model: izolację organizacji, szyfrowanie transmisji, kontrolę dostępu i plan produkcyjnych backupów.',
    links: [
      ['Jak chronimy dane', '/bezpieczenstwo'],
      ['Zgłoś incydent', 'mailto:bezpieczenstwo@xn--przyda-8ib.pl'],
    ],
  },
  {
    eyebrow: 'Dokumenty',
    title: 'Formalności w jednym miejscu.',
    text: 'Regulamin, zasady prywatności, cookies i dokumentacja infrastruktury są dostępne bez logowania.',
    links: [
      ['Regulamin', '/regulamin'],
      ['Dokumenty prawne', '/polityka-prywatnosci'],
    ],
  },
];

const securityFaq = [
  ['Czy dane różnych firm są od siebie oddzielone?', 'Tak. Przydaś wykorzystuje organizacje, role i reguły dostępu po stronie bazy. Nie polegamy wyłącznie na tym, co jest ukryte w interfejsie.'],
  ['Gdzie znajdują się podstawowe dane?', 'Główny projekt Supabase działa w regionie West EU — Irlandia, czyli na terenie Unii Europejskiej.'],
  ['Co w przypadku utraty hasła lub podejrzanego logowania?', 'System rozwija kontrolę nowych urządzeń oraz dodatkową weryfikację. Incydenty można zgłaszać bezpośrednio na dedykowany adres bezpieczeństwa.'],
  ['Czy Przydaś ma już produkcyjny backup?', 'Przed płatnym startem wymagamy automatycznych kopii na planie produkcyjnym, niezależnej kopii danych i plików oraz testów odtworzenia. Nie opisujemy planu jako wdrożonego, dopóki nie zostanie faktycznie uruchomiony i sprawdzony.'],
];
---

<section class="legal-hub" id="formalnosci">
  <div class="legal-hub-shell">
    <div class="legal-hub-head">
      <span>Kontakt · RODO · bezpieczeństwo · dokumenty</span>
      <h2>Strona firmy powinna odpowiadać też na trudne pytania.</h2>
      <p>Dlatego ważne informacje są publiczne i dostępne bez logowania — od zwykłego kontaktu po prywatność oraz sposób ochrony danych.</p>
    </div>

    <div class="legal-hub-grid">
      {legalCards.map((card) => (
        <article class="legal-hub-card">
          <span>{card.eyebrow}</span>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
          <div class="legal-links">
            {card.links.map(([label, href]) => <a href={href}>{label} <b>→</b></a>)}
          </div>
        </article>
      ))}
    </div>

    <div class="security-faq">
      <div class="security-faq-copy">
        <span>Najczęstsze pytania o dane</span>
        <h3>Nie chowamy bezpieczeństwa w przypisie.</h3>
        <p>Krótko i konkretnie: co działa dziś, co jest częścią architektury i co musi zostać domknięte przed sprzedażą komercyjną.</p>
        <a href="/bezpieczenstwo">Pełna informacja o bezpieczeństwie →</a>
      </div>
      <div class="security-faq-list">
        {securityFaq.map(([q, a]) => (
          <details>
            <summary>{q}<span>+</span></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<footer class="complete-footer">
  <div class="complete-footer-shell footer-top">
    <div class="footer-brand-block">
      <a href="/" class="footer-brand-new">
        <img src="/przydas-mark.svg" alt="" />
        <div><strong>Przydaś</strong><span>System dla branży animacyjnej</span></div>
      </a>
      <p>Mniej pilnowania. Więcej czasu na firmę.</p>
    </div>

    <div class="footer-column">
      <strong>Produkt</strong>
      <a href="/#korzysci">Korzyści</a>
      <a href="/#jak-dziala">Jak działa</a>
      <a href="/#cennik">Cennik</a>
      <a href="/#porownanie">Porównanie</a>
      <a href="/#faq">FAQ</a>
    </div>

    <div class="footer-column">
      <strong>Pomoc i kontakt</strong>
      <a href="/kontakt">Kontakt</a>
      <a href="mailto:sprzedaz@xn--przyda-8ib.pl">Sprzedaż</a>
      <a href="mailto:wsparcie@xn--przyda-8ib.pl">Wsparcie</a>
      <a href="mailto:bezpieczenstwo@xn--przyda-8ib.pl">Bezpieczeństwo</a>
      <a href="https://app.xn--przyda-8ib.pl/">Logowanie</a>
    </div>

    <div class="footer-column">
      <strong>Prawo i dane</strong>
      <a href="/regulamin">Regulamin</a>
      <a href="/polityka-prywatnosci">Polityka prywatności</a>
      <a href="/cookies">Cookies i storage</a>
      <a href="/podprocesorzy">Podprocesorzy</a>
      <a href="/bezpieczenstwo">Bezpieczeństwo danych</a>
    </div>
  </div>

  <div class="complete-footer-shell footer-contact-strip">
    <div><span>Sprzedaż</span><a href="mailto:sprzedaz@xn--przyda-8ib.pl">sprzedaz@przydaś.pl</a></div>
    <div><span>Wsparcie</span><a href="mailto:wsparcie@xn--przyda-8ib.pl">wsparcie@przydaś.pl</a></div>
    <div><span>RODO / incydenty</span><a href="mailto:bezpieczenstwo@xn--przyda-8ib.pl">bezpieczenstwo@przydaś.pl</a></div>
  </div>

  <div class="complete-footer-shell footer-bottom-new">
    <span>© 2026 Przydaś</span>
    <span>Dokumentacja prawna v1.0 · 25.08.2026</span>
  </div>
</footer>

<style>
  .legal-hub { padding:96px 0; background:#f5f9f7; color:#10201a; border-top:1px solid #e1e9e5; }
  .legal-hub-shell,.complete-footer-shell { width:min(1180px,calc(100% - 40px)); margin:0 auto; }
  .legal-hub-head { max-width:760px; margin-bottom:40px; }
  .legal-hub-head > span,.security-faq-copy > span,.legal-hub-card > span { color:#087f53; font-size:11px; font-weight:900; letter-spacing:.09em; text-transform:uppercase; }
  .legal-hub-head h2 { margin:10px 0 16px; font-size:clamp(34px,5vw,58px); line-height:1.02; letter-spacing:-.045em; }
  .legal-hub-head p { margin:0; color:#617169; font-size:17px; line-height:1.65; }
  .legal-hub-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; }
  .legal-hub-card { min-height:285px; padding:24px; display:flex; flex-direction:column; border:1px solid #dfe8e3; border-radius:18px; background:#fff; }
  .legal-hub-card h3 { margin:10px 0 10px; font-size:22px; line-height:1.15; letter-spacing:-.025em; }
  .legal-hub-card p { margin:0; color:#6a7770; font-size:13px; line-height:1.55; }
  .legal-links { margin-top:auto; padding-top:22px; display:grid; gap:9px; }
  .legal-links a { color:#17382b; font-size:12px; font-weight:800; text-decoration:none; display:flex; justify-content:space-between; gap:10px; }
  .legal-links a:hover { color:#087f53; }
  .legal-links b { color:#087f53; }
  .security-faq { margin-top:18px; padding:30px; display:grid; grid-template-columns:.8fr 1.2fr; gap:54px; border:1px solid #d9e5df; border-radius:22px; background:#10201a; color:#fff; }
  .security-faq-copy h3 { margin:10px 0 12px; font-size:32px; letter-spacing:-.035em; }
  .security-faq-copy p { color:#aebfb6; font-size:14px; line-height:1.6; }
  .security-faq-copy a { display:inline-block; margin-top:12px; color:#8fe0b9; font-size:12px; font-weight:800; text-decoration:none; }
  .security-faq-list details { border-bottom:1px solid #2d4439; }
  .security-faq-list summary { padding:17px 0; display:flex; justify-content:space-between; gap:20px; cursor:pointer; list-style:none; font-size:13px; font-weight:800; }
  .security-faq-list summary::-webkit-details-marker { display:none; }
  .security-faq-list summary span { color:#8fe0b9; font-size:18px; }
  .security-faq-list details[open] summary span { transform:rotate(45deg); }
  .security-faq-list p { margin:-4px 28px 17px 0; color:#aebfb6; font-size:12px; line-height:1.65; }
  .complete-footer { background:#0b1712; color:#fff; }
  .footer-top { padding:58px 0 42px; display:grid; grid-template-columns:1.5fr repeat(3,1fr); gap:50px; }
  .footer-brand-new { display:flex; gap:12px; align-items:center; color:#fff; text-decoration:none; }
  .footer-brand-new img { width:40px; height:40px; }
  .footer-brand-new div { display:flex; flex-direction:column; gap:1px; }
  .footer-brand-new strong { font-size:20px; }
  .footer-brand-new span,.footer-brand-block p { color:#8fa299; font-size:11px; }
  .footer-brand-block p { margin:18px 0 0; max-width:250px; line-height:1.6; }
  .footer-column { display:grid; align-content:start; gap:10px; }
  .footer-column strong { margin-bottom:4px; color:#fff; font-size:12px; }
  .footer-column a { color:#99aaa2; font-size:11px; text-decoration:none; }
  .footer-column a:hover { color:#fff; }
  .footer-contact-strip { padding:18px 0; display:grid; grid-template-columns:repeat(3,1fr); gap:12px; border-top:1px solid #203028; border-bottom:1px solid #203028; }
  .footer-contact-strip div { display:flex; flex-direction:column; gap:2px; }
  .footer-contact-strip span { color:#708279; font-size:9px; font-weight:800; text-transform:uppercase; letter-spacing:.08em; }
  .footer-contact-strip a { color:#cbd7d1; font-size:11px; text-decoration:none; }
  .footer-bottom-new { min-height:74px; display:flex; align-items:center; justify-content:space-between; gap:20px; color:#667970; font-size:10px; }
  @media (max-width:960px) {
    .legal-hub-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .security-faq { grid-template-columns:1fr; gap:24px; }
    .footer-top { grid-template-columns:1.4fr repeat(2,1fr); }
    .footer-column:last-child { grid-column:2 / 4; }
  }
  @media (max-width:640px) {
    .legal-hub { padding:68px 0; }
    .legal-hub-shell,.complete-footer-shell { width:min(100% - 24px,1180px); }
    .legal-hub-grid { grid-template-columns:1fr; }
    .legal-hub-card { min-height:0; }
    .security-faq { padding:22px 18px; }
    .footer-top { padding-top:42px; grid-template-columns:1fr 1fr; gap:34px 20px; }
    .footer-brand-block { grid-column:1 / -1; }
    .footer-column:last-child { grid-column:auto; }
    .footer-contact-strip { grid-template-columns:1fr; gap:13px; }
    .footer-bottom-new { min-height:86px; align-items:flex-start; justify-content:center; flex-direction:column; gap:3px; }
  }
</style>
