  .onboarding-steps p { margin: 0; color: #9fb0a6; font-size: 12px; line-height: 1.45; }

  .faq-section { padding: 108px 0; background: #f7faf8; }
  .faq-shell { display: grid; grid-template-columns: .8fr 1.2fr; gap: 70px; align-items: start; }
  .faq-head { position: sticky; top: 118px; margin-bottom: 0; }
  .faq-list { display: grid; gap: 10px; }
