  .footer-main nav a:hover { color: #6fe0ad; }
  .footer-bottom { padding-top: 22px; border-top: 1px solid #26352d; display: flex; justify-content: space-between; gap: 24px; color: #71837a; font-size: 10px; }

  @media (max-width: 900px) {
