  .comparison-outcome-business { border-color: #8bd6b2; background: linear-gradient(155deg, #effaf4, #e1f6eb); }
  .comparison-outcome > span { display: inline-flex; padding: 7px 10px; border-radius: 999px; color: #078a59; background: #eaf8f2; font-size: 9px; font-weight: 900; letter-spacing: .07em; }
  .comparison-outcome-business > span { color: #fff; background: #078a59; }
